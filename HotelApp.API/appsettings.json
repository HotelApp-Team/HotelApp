    "SenderName": "HotelApp", //Mail gondericisinde gorunecek isim
    "VerifyEmailBaseUrl": "https://localhost:7001/api/auth/verify-email" //Email dogrulama linkinin temel adresi
  },
  "AuthSettings": {
    "UseEmailVerification": true //Register sonrasi email dogrulamayi zorunlu tutar
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
