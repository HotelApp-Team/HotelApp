{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=HotelAppDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "HotelApp.API", //Token'ı oluşturan taraf
    "Audience": "HotelApp.Client", //Token'ı kullanacak olan taraf
    "SecretKey": "BuCokGizliBirAnahtarOlmaliEnAz32Karakter12345", //Sunucunun tokeni imzaladigi gizli anahtar
    "ExpirationMinutes": 60, //Tokenin geçerlilik süresi (dakika cinsinden)
