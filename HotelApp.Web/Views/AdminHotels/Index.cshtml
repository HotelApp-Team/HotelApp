@model HotelApp.Web.Models.AdminHotelListPageViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Otel Yönetimi";

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
    if (totalPages < 1) totalPages = 1;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-building text-primary me-2"></i>
            Otel Yönetimi
        </h2>
        <a asp-controller="AdminHotels" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Yeni Otel Ekle
        </a>
    </div>

    @* Arama ve Filtreleme formu *@
    <form method="get" asp-controller="AdminHotels" asp-action="Index" class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-search text-primary me-2"></i>
                Arama ve Filtreleme
            </h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div style="flex: 1 1 180px; min-width: 160px;">
                    <label class="form-label small text-muted">Şehir</label>
                    <select asp-for="City" class="form-select admin-filter-select" data-searchable="true">
                        <option value="">Tümü</option>
                        @foreach (var cityOption in Model.CityOptions)
                        {
                            <option value="@cityOption">@cityOption</option>
                        }
                    </select>
                </div>
                <div style="flex: 1 1 200px; min-width: 180px;">
                    <label class="form-label small text-muted">Otel</label>
                    <select asp-for="HotelId" class="form-select admin-filter-select" data-searchable="true">
                        <option value="">Tümü</option>
                        @foreach (var hotelOption in Model.HotelOptions)
                        {
                            <option value="@hotelOption.Id" data-city="@hotelOption.City">@hotelOption.Name</option>
                        }
                    </select>
                </div>
                <div style="width: 110px;">
                    <label class="form-label small text-muted">Yıldız</label>
                    <select asp-for="StarRating" class="form-select admin-filter-select">
                        <option value="">Tümü</option>
                        @for (byte i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i Yıldız</option>
                        }
                    </select>
                </div>
                <div style="width: 110px;">
                    <label class="form-label small text-muted">Durum</label>
                    <select asp-for="IsActive" class="form-select admin-filter-select">
                        <option value="">Hepsi</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>
                <div style="width: 130px;">
                    <label class="form-label small text-muted">Sıralama</label>
                    <select asp-for="SortBy" class="form-select admin-filter-select">
                        <option value="name">Ada göre</option>
                        <option value="city">Şehre göre</option>
                        <option value="star">Yıldıza göre</option>
                    </select>
                </div>
                <div style="width: 110px;">
                    <label class="form-label small text-muted">Sıra</label>
                    <select asp-for="SortOrder" class="form-select admin-filter-select">
                        <option value="asc">Artan</option>
                        <option value="desc">Azalan</option>
                    </select>
                </div>
                <div class="ms-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </form>

    @* Liste kart *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Oteller
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.TotalCount</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model.Hotels.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Otel</th>
                                <th>Şehir</th>
                                <th>Ülke</th>
                                <th>Yıldız</th>
                                <th>Durum</th>
                                <th>Min. Fiyat</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hotel in Model.Hotels)
                            {
                                <tr>
                                    <td class="text-muted small">#@hotel.Id</td>
                                    <td class="fw-semibold">@hotel.Name</td>
                                    <td>@hotel.City</td>
                                    <td>@hotel.Country</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star-fill"></i> @hotel.StarRating
                                        </span>
                                    </td>
                                    <td>
                                        @if (hotel.IsActive)
                                        {
                                            <span class="status-pill active">
                                                <span class="status-dot"></span>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill passive">
                                                <span class="status-dot"></span>
                                                Pasif
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(hotel.MinPrice.HasValue ? hotel.MinPrice.Value.ToString("N2") + " ₺" : "-")
                                    </td>
                                    <td class="text-end">
                                        <div class="action-group">
                                            <a asp-controller="AdminHotels" asp-action="Edit" asp-route-id="@hotel.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil-square"></i> Düzenle
                                            </a>

                                            <form asp-controller="AdminHotels"
                                                  asp-action="Delete"
                                                  asp-route-id="@hotel.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu oteli silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sayfalama *@
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                        <span class="small text-muted">
                            Sayfa @Model.Page / @totalPages
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="AdminHotels"
                                       asp-action="Index"
                                       asp-route-city="@Model.City"
                                       asp-route-hotelId="@Model.HotelId"
                                       asp-route-starRating="@Model.StarRating"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-sortBy="@Model.SortBy"
                                       asp-route-sortOrder="@Model.SortOrder"
                                       asp-route-page="@(Model.Page - 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        <i class="bi bi-chevron-left"></i> Önceki
                                    </a>
                                </li>
                                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="AdminHotels"
                                       asp-action="Index"
                                       asp-route-city="@Model.City"
                                       asp-route-hotelId="@Model.HotelId"
                                       asp-route-starRating="@Model.StarRating"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-sortBy="@Model.SortBy"
                                       asp-route-sortOrder="@Model.SortOrder"
                                       asp-route-page="@(Model.Page + 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        Sonraki <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Otel kaydı bulunamadı.
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Sehir secimine gore otel dropdown'ini daraltir.
        // Tom Select ornekleri site.js icinde DOMContentLoaded sirasinda olusturulur;
        // bu blok daha sonra calistigi icin ornekler hazir olur.
        document.addEventListener('DOMContentLoaded', function () {
            var citySelect = document.getElementById('City');
            var hotelSelect = document.getElementById('HotelId');
            if (!citySelect || !hotelSelect) return;

            var cityTs = citySelect.tomselect;
            var hotelTs = hotelSelect.tomselect;
            if (!cityTs || !hotelTs) return;

            // Tum otel secenekleri (deger, ad, sehir) baslangicta DOM'dan toplanir.
            var allHotels = Array.prototype.map.call(hotelSelect.options, function (o) {
                return { value: o.value, text: o.text, city: o.getAttribute('data-city') || '' };
            }).filter(function (o) { return o.value !== ''; });

            function refreshHotels() {
                var city = (cityTs.getValue() || '').toLowerCase();
                var selected = hotelTs.getValue();

                // Onceki secimi sessizce kaldir ki clearOptions tum secenekleri silebilsin
                // (Tom Select secili kalan secenegi silmez, bu da sirayi bozardi).
                hotelTs.clear(true);
                hotelTs.clearOptions();

                var matches = allHotels.filter(function (h) {
                    return !city || h.city.toLowerCase() === city;
                });

                // $order'i acikca veriyoruz. DIKKAT: Tom Select "opt.$order || ++order"
                // kullandigi icin 0 (falsy) yok sayilir; bu yuzden 1'den basliyoruz ki
                // "Tümü" (en kucuk $order) her zaman listenin en ustunde kalir.
                var opts = [{ value: '', text: 'Tümü', $order: 1 }];
                matches.forEach(function (h, i) {
                    opts.push({ value: h.value, text: h.text, $order: i + 2 });
                });
                hotelTs.addOptions(opts);

                // Secili otel artik listede yoksa "Tümü"ye don.
                var stillValid = !selected || matches.some(function (h) { return h.value === selected; });
                hotelTs.setValue(stillValid ? selected : '', true);
                hotelTs.refreshOptions(false);
            }

            cityTs.on('change', refreshHotels);

            // Sayfa ilk acildiginda secili sehir varsa otel listesini ona gore daralt.
            if (cityTs.getValue()) {
                refreshHotels();
            }
        });
    </script>
}
