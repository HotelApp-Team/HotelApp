    </aside>
</div>

</div>@* /#hpEditRoot *@

@* Oda gorseli buyutme modali (RoomImages ozelligi - Sevde) *@
<div class="modal fade" id="roomImageModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-body p-0">
                <img id="roomImageModalImg"
                     src=""
                     style="width:100%;max-height:80vh;object-fit:contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Otel duzenleme sayfasi etkilesimleri. Tum olay dinleyicileri "delegasyon" ile
        // document uzerine baglanir; boylece AJAX ile #hpEditRoot icerigi degistiginde
        // dinleyicileri tekrar baglamaya gerek kalmaz.
        (function () {
            var ROOT_ID = 'hpEditRoot';
            var order = ['general', 'images', 'amenities', 'rooms'];

            function root() { return document.getElementById(ROOT_ID); }
            function stepper() { return document.getElementById('hpWizardSteps'); }
            function isEditMode() { return !!stepper(); }
            function hotelKey() { var s = stepper(); return s ? (s.getAttribute('data-hotel-id') || '0') : '0'; }
            function storeKey() { return 'hpWizardStep:' + hotelKey(); }
            function panel(k) { return document.querySelector('.hp-step-panel[data-step="' + k + '"]'); }
            function stepBtn(k) { var s = stepper(); return s ? s.querySelector('.hp-wstep[data-step-target="' + k + '"]') : null; }

            // ---- Wizard: adim goster ----
            function showStep(key, userInitiated) {
                if (!stepper()) return;
                if (order.indexOf(key) === -1) key = 'general';
                order.forEach(function (k) {
                    var p = panel(k), b = stepBtn(k);
                    if (p) p.classList.toggle('active', k === key);
                    if (b) b.classList.toggle('active', k === key);
                });
                var idx = order.indexOf(key);
                var prevBtn = document.getElementById('hpWizPrev');
                var nextBtn = document.getElementById('hpWizNext');
                var finishBtn = document.getElementById('hpWizFinish');
                var indicator = document.getElementById('hpWizIndicator');
                if (prevBtn) prevBtn.disabled = (idx === 0);
                var last = (idx === order.length - 1);
                if (nextBtn) nextBtn.style.display = last ? 'none' : '';
                if (finishBtn) finishBtn.style.display = last ? '' : 'none';
                if (indicator) indicator.textContent = 'Adım ' + (idx + 1) + ' / ' + order.length;
                try { sessionStorage.setItem(storeKey(), key); } catch (e) { }
                if (history.replaceState) { history.replaceState(null, '', '#step-' + key); } else { location.hash = 'step-' + key; }
                if (userInitiated) { window.scrollTo({ top: 0, behavior: 'smooth' }); }
            }

            function currentStep() {
                for (var i = 0; i < order.length; i++) {
                    var p = panel(order[i]);
                    if (p && p.classList.contains('active')) return order[i];
                }
                return 'general';
            }

            // Saklanan/hash'teki adimi uygular (ilk yukleme ve AJAX swap sonrasi).
            function applyWizardStep() {
                if (!stepper()) return;
                var main = document.querySelector('.hp-main');
                if (main) main.classList.add('hp-wizard-on');
                var fromHash = (location.hash || '').replace('#step-', '');
                var fromStore = '';
                try { fromStore = sessionStorage.getItem(storeKey()) || ''; } catch (e) { }
                var initial = order.indexOf(fromHash) !== -1 ? fromHash
                    : (order.indexOf(fromStore) !== -1 ? fromStore : 'general');
                showStep(initial, false);
            }

            // ---- Oda akordeon + alt sekme ----
            var ROOM_TABS = ['info', 'amenities', 'images'];
            function roomKey() { return 'hpRoomOpen:' + hotelKey(); }
            function roomTabKey(id) { return 'hpRoomTab:' + hotelKey() + ':' + id; }
            function storedSubtab(id) {
                var t = ''; try { t = sessionStorage.getItem(roomTabKey(id)) || ''; } catch (e) { }
                return ROOM_TABS.indexOf(t) !== -1 ? t : 'info';
            }
            function setRoomSubtab(card, tab, persist) {
                if (ROOM_TABS.indexOf(tab) === -1) tab = 'info';
                card.querySelectorAll('.hp-room-subtab').forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-subtab') === tab); });
                card.querySelectorAll('.hp-room-subpanel').forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-subpanel') === tab); });
                if (persist) { try { sessionStorage.setItem(roomTabKey(card.getAttribute('data-room-id')), tab); } catch (e) { } }
            }
            function openRoom(card) {
                document.querySelectorAll('.hp-room-card.open').forEach(function (c) { if (c !== card) c.classList.remove('open'); });
                card.classList.add('open');
                try { sessionStorage.setItem(roomKey(), card.getAttribute('data-room-id')); } catch (e) { }
                setRoomSubtab(card, storedSubtab(card.getAttribute('data-room-id')), false);
            }
            function closeRoom(card) {
                card.classList.remove('open');
                try { if (sessionStorage.getItem(roomKey()) === card.getAttribute('data-room-id')) sessionStorage.removeItem(roomKey()); } catch (e) { }
            }
            // Saklanan acik oda + aktif alt sekme durumunu uygular (ilk yukleme ve AJAX swap sonrasi).
            function applyRoomAccordion() {
                var openId = ''; try { openId = sessionStorage.getItem(roomKey()) || ''; } catch (e) { }
                document.querySelectorAll('.hp-room-card').forEach(function (card) {
                    var id = card.getAttribute('data-room-id');
                    setRoomSubtab(card, storedSubtab(id), false);
                    card.classList.toggle('open', id === openId);
                });
            }

            // ---- Fiyat (tr-TR) bicimleme ----
            function formatMoneyTR(raw) {
                var s = (raw || '').replace(/[^\d,]/g, '');
                var c = s.indexOf(',');
                var intPart, decPart = '', hasComma = c >= 0;
                if (hasComma) { intPart = s.slice(0, c).replace(/\D/g, ''); decPart = s.slice(c + 1).replace(/\D/g, '').slice(0, 2); }
                else { intPart = s.replace(/\D/g, ''); }
                intPart = intPart.replace(/^0+(?=\d)/, '');
                if (intPart === '') intPart = '0';
                var grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                return hasComma ? grouped + ',' + decPart : grouped;
            }
            function moneyToInvariant(v) { return (v || '').replace(/\./g, '').replace(',', '.'); }

            // ---- AJAX: donen Edit HTML'inden #hpEditRoot'u yerinde degistir ----
            function swapRoot(html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var newRoot = doc.getElementById(ROOT_ID), curRoot = root();
                if (!newRoot || !curRoot) { window.location.reload(); return; }
                curRoot.innerHTML = newRoot.innerHTML;
                if (window.initAdminFilterSelects) window.initAdminFilterSelects(curRoot);
                applyWizardStep();
                applyRoomAccordion();
            }

            // ===== Delegasyon: tiklamalar =====
            document.addEventListener('click', function (e) {
                // Yildiz secici
                var star = e.target.closest('.hp-star');
                if (star) {
                    var group = star.closest('.hp-star-pick');
                    if (group) {
                        var input = document.querySelector('input[name="' + group.getAttribute('data-target') + '"]');
                        var val = parseInt(star.getAttribute('data-value'), 10);
                        if (input) input.value = val;
                        group.querySelectorAll('.hp-star').forEach(function (st, i) {
                            var on = i < val;
                            st.classList.toggle('on', on);
                            var icon = st.querySelector('i');
                            if (icon) icon.className = 'bi ' + (on ? 'bi-star-fill' : 'bi-star');
                        });
                    }
                    return;
                }
                // Wizard adim butonlari
                var ws = e.target.closest('.hp-wstep');
                if (ws) { showStep(ws.getAttribute('data-step-target'), true); return; }
                if (e.target.closest('#hpWizPrev')) { var i = order.indexOf(currentStep()); if (i > 0) showStep(order[i - 1], true); return; }
                if (e.target.closest('#hpWizNext')) { var j = order.indexOf(currentStep()); if (j < order.length - 1) showStep(order[j + 1], true); return; }
                // Oda olanagi kaldir: ilgili checkbox'i kaldir ve formu gonder
                var rmChip = e.target.closest('.js-room-amenity-remove');
                if (rmChip) {
                    var cb = document.getElementById(rmChip.getAttribute('data-checkbox'));
                    if (cb) cb.checked = false;
                    var f = document.getElementById(rmChip.getAttribute('data-form'));
                    if (f) { if (typeof f.requestSubmit === 'function') f.requestSubmit(); else f.submit(); }
                    return;
                }
                // Oda gorseli buyutme modali
                var thumb = e.target.closest('.admin-room-thumb');
                if (thumb) {
                    var t = document.getElementById('roomImageModalImg');
                    if (t) t.src = thumb.dataset.imageUrl;
                    return;
                }
                // Oda alt sekme degistir
                var rsub = e.target.closest('.hp-room-subtab');
                if (rsub) {
                    var rc = rsub.closest('.hp-room-card');
                    if (rc) setRoomSubtab(rc, rsub.getAttribute('data-subtab'), true);
                    return;
                }
                // Oda kart basligi: akordeon ac/kapa (basliktaki buton/form/link/secim disinda)
                var rtoggle = e.target.closest('.hp-room-toggle');
                if (rtoggle && !e.target.closest('button, a, form, input, select, label')) {
                    var card2 = rtoggle.closest('.hp-room-card');
                    if (card2) { card2.classList.contains('open') ? closeRoom(card2) : openRoom(card2); }
                }
            });

            // ===== Delegasyon: input (fiyat + telefon) =====
            document.addEventListener('input', function (e) {
                var el = e.target;
                if (!el || !el.classList) return;
                if (el.classList.contains('js-money')) {
                    var f = formatMoneyTR(el.value);
                    if (f !== el.value) { el.value = f; try { el.setSelectionRange(el.value.length, el.value.length); } catch (x) { } }
                    return;
                }
                if (el.hasAttribute && el.hasAttribute('data-phone-input')) {
                    var cleaned = el.value.replace(/[^0-9+\-\s()]/g, '');
                    if (cleaned !== el.value) {
                        var pos = el.selectionStart - (el.value.length - cleaned.length);
                        el.value = cleaned;
                        try { el.setSelectionRange(pos, pos); } catch (x2) { }
                    }
                }
            });

            // ===== Delegasyon: oda gorsellerinde "Ana" tek-secim (radyo gibi) =====
            // Bir odanin gorsellerinde birden fazla "Ana" isaretlenemesin; biri
            // isaretlenince ayni odadaki diger "Ana" kutulari otomatik kalkar.
            document.addEventListener('change', function (e) {
                var el = e.target;
                if (!el || el.type !== 'checkbox' || el.name !== 'IsMain' || !el.checked) return;
                var box = el.closest('.hp-room-images');
                if (!box) return;
                box.querySelectorAll('input[type="checkbox"][name="IsMain"]').forEach(function (cb) {
                    if (cb !== el) cb.checked = false;
                });
            });

            // ===== Delegasyon: form submit (fiyat normalize + AJAX) =====
            document.addEventListener('submit', function (e) {
                var form = e.target;
                if (!form || form.tagName !== 'FORM') return;
                var r = root();
                if (!r || !r.contains(form)) return;       // sadece duzenleme kokundeki formlar
                if (e.defaultPrevented) return;            // client validation engellediyse dokunma

                // Gorunen tr-TR fiyatlari server'in bekledigi invariant ("1500.99") forma cevir.
                form.querySelectorAll('.js-money').forEach(function (m) { m.value = moneyToInvariant(m.value); });

                // AJAX yalniz edit modunda ve data-no-ajax olmayan formlarda.
                if (!isEditMode() || form.hasAttribute('data-no-ajax')) return;

                e.preventDefault();
                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                })
                    .then(function (resp) { return resp.text(); })
                    .then(function (html) { swapRoot(html); })
                    .catch(function () { form.submit(); }); // hata olursa normal gonderim
            });

            // İlk yukleme: edit modunda dogru adimi ve oda akordeon durumunu uygula.
            if (isEditMode()) { applyWizardStep(); applyRoomAccordion(); }
        })();
    </script>
}
