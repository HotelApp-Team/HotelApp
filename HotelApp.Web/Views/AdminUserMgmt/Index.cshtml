@model HotelApp.Web.Models.AdminUsersPageViewModel
@{
    ViewData["Title"] = "Kullanici Yonetimi";
    Layout = "_AdminLayout";

    // Sayfalama hesabi: toplam kayit / sayfa basi -> toplam sayfa.
    // Bos sonuc durumunda Math.Ceiling 0 doner; bunu en az 1 olarak tutuyoruz ki view bozulmasin.
    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
    if (totalPages < 1) totalPages = 1;
}

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Kullanici Yonetimi
        </h2>
    </div>

    @* Filtre formu: GET ile gonderilir, filtreler URL query string'ine yansir *@
    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Arama</label>
                    <input type="text" name="search" value="@Model.Search"
                           class="form-control" placeholder="Ad, soyad veya email" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Durum</label>
                    <select name="isActive" class="form-select">
                        <option value="">Hepsi</option>
                        <option value="true" selected="@(Model.IsActive == true)">Aktif</option>
                        <option value="false" selected="@(Model.IsActive == false)">Pasif</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </form>

    @* Listeleme tablosu *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Kullanicilar
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.TotalCount</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Ad Soyad</th>
                                <th>Email</th>
                                <th>Telefon</th>
                                <th>Roller</th>
                                <th>Durum</th>
                                <th>Kayıt</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td>@($"{user.FirstName} {user.LastName}".Trim())</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                    <td>
                                        @if (user.Roles is not null && user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                var roleClass = role == "Admin" ? "bg-primary" : "bg-secondary";
                                                <span class="badge @roleClass me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pasif</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        @* Durum degistirme formu: aktifi pasife / pasifi aktife cevirir *@
                                        <form asp-action="ChangeStatus" asp-route-id="@user.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="isActive" value="@((!user.IsActive).ToString().ToLower())" />
                                            <button type="submit"
                                                    class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                @(user.IsActive ? "Pasif" : "Aktif")
                                            </button>
                                        </form>

                                        @* Rol duzenleme: per-row modal acan buton *@
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal" data-bs-target="#rolesModal-@user.Id">
                                            Roller
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sayfalama *@
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                        <span class="small text-muted">
                            Sayfa @Model.CurrentPage / @totalPages
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.PageSize">Onceki</a>
                                </li>
                                <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.PageSize">Sonraki</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Kullanici bulunamadi.
                </div>
            }

        </div>
    </div>

</div>

@* Her kullanici icin ayri rol modal'i: Bootstrap data-bs-target ile per-row hedef *@
@if (Model.Users.Any())
{
    foreach (var user in Model.Users)
    {
        <div class="modal fade" id="rolesModal-@user.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-action="ChangeRoles" asp-route-id="@user.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Rolleri Duzenle</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small mb-3">
                                <strong>@user.Email</strong>
                            </p>

                            @{
                                // Mevcut rolleri kontrol et; modal acildiginda var olan roller checked baslasin
                                var hasAdmin = user.Roles?.Contains("Admin") == true;
                                var hasUser = user.Roles?.Contains("User") == true;
                            }

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="roles" value="Admin"
                                       id="role-admin-@user.Id" checked="@hasAdmin" />
                                <label class="form-check-label" for="role-admin-@user.Id">
                                    <span class="badge bg-primary me-1">Admin</span>
                                    Admin paneli erisimi
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="User"
                                       id="role-user-@user.Id" checked="@hasUser" />
                                <label class="form-check-label" for="role-user-@user.Id">
                                    <span class="badge bg-secondary me-1">User</span>
                                    Standart kullanici
                                </label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgec</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
