@* Bu sayfa ForgotPasswordViewModel adinda bir veri kutusu bekliyor. Controller bos da olsa bir tane gonderir. *@
@model HotelApp.Web.Models.ForgotPasswordViewModel

@{
    @* Tarayici sekmesinde gorunecek baslik (Layout otomatik aliyor). *@
    ViewData["Title"] = "Şifremi Unuttum";
    ViewData["IsAuthPage"] = true;

    // Hero sayaçlarını ham DB sayısından kullanıcıya güven veren 10'luk ifadeye çevirir.
    int RoundStatForHero(int count) => count >= 10 ? (count / 10) * 10 : count;
}

@* AUTH SPLIT — Login ve Register sayfalariyla ayni kart/gorsel yapisi kullanilir. *@
<section class="auth-split">
    <div class="auth-card">

        @* SOL: hero gorseli + serif slogan + istatistikler *@
        <aside class="auth-visual">
            <div class="auth-visual-overlay"></div>
            <div class="auth-visual-content">
                <span class="hero-eyebrow">
                    <span class="hero-dot"></span>
                    @if (Model.HeroStats is not null)
                    {
                        <text>@RoundStatForHero(Model.HeroStats.HotelCount)+ otel · @RoundStatForHero(Model.HeroStats.CityCount)+ şehir · </text>
                    }
                    güvenli hesap işlemleri
                </span>
                <div class="auth-visual-bottom">
                    <h2 class="auth-visual-title">Merak etme.<br />Hesabına yeniden ulaşman için buradayız.</h2>
                    <div class="auth-stats">
                        @if (Model.HeroStats is not null)
                        {
                            <div class="auth-stat"><b>@RoundStatForHero(Model.HeroStats.HotelCount)+</b><span>otel</span></div>
                            <div class="auth-stat"><b>@RoundStatForHero(Model.HeroStats.CityCount)+</b><span>şehir</span></div>
                        }
                        <div class="auth-stat"><b>30 dk</b><span>link süresi</span></div>
                    </div>
                </div>
            </div>
        </aside>

        @* SAG: form *@
        <div class="auth-form-col">
            <div class="auth-form-inner">

                <span class="section-eyebrow">Hesap Güvenliği</span>
                <h1 class="auth-title">Şifremi Unuttum</h1>
                <p class="auth-sub">Email adresini yaz; hesabın varsa şifre yenileme bağlantısını mail olarak gönderelim.</p>

                @if (Model.IsSubmitted && !string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-success">
                        @Model.Message
                    </div>
                }

                <form asp-action="ForgotPassword" asp-controller="Auth" method="post" class="auth-form">
                    @* Form sahteciligine karsi guvenlik anahtari (CSRF korumasi). *@
                    @Html.AntiForgeryToken()

                    @* Backend'den gelen genel hatalar burada gorunur. *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3 auth-field">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input asp-for="Email" autocomplete="email" class="form-control auth-input" placeholder="ornek@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-auth">Şifre Yenileme Linki Gönder</button>

                    @* Login sayfasina geri donus linki. *@
                    <div class="text-center mt-3 auth-foot">
                        <span>Şifreni hatırladın mı?</span>
                        <a asp-action="Login">Giriş Yap <i class="bi bi-arrow-right"></i></a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</section>

@* Validation'in tarayicida da calismasi icin gerekli. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
