@* Bu sayfa VerifyEmailViewModel ile gelir, duruma gore basari/hata gosteririr. *@
@model HotelApp.Web.Models.VerifyEmailViewModel
@{
    ViewData["Title"] = "Email Doğrulama";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        @if (Model.IsSuccess)
        {
            @* Basarili durumu: yesil alert + anasayfa butonu*@
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Email Doğrulama Başarılı!</h4>
                <p class="mb-0">@Model.Message</p>
            </div>
            <div class="d-grid">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Anasayfaya Git</a>
            </div>
        }
        else
        {
            @*Basarisiz durumu: kirmizi alert + bilgilendirici ipucu + Resend formu*@
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Email Doğrulama Başarısız</h4>
                <p class="mb-0">@Model.Message</p>
            </div>

            @* Token tek kullanimlik oldugu icin ayni link ikinci kez acilirsa hata gelir.
               Eger kullanici zaten dogrulanmissa "giris yap" yolunu net gosteriyoruz. *@
            <div class="alert alert-light border" role="alert">
                <i class="bi bi-info-circle me-1"></i>
                Eğer hesabınızı daha önce doğruladıysanız doğrudan
                <a asp-action="Login" class="alert-link">giriş yapabilirsiniz</a>.
            </div>

            @* Resend formu - kullanici email girip tekrar dogrulama maili isteyebilir.*@
            <partial name="_ResendVerificationForm"
                model="@(new HotelApp.Web.Models.ResendVerificationViewModel { Email = Model.Email})" />
            <div class="text-center mt-3">
                <a asp-action="Login">Giriş sayfasına dön</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @* Client-side validation için gerekli scriptler*@
    <partial name="_ValidationScriptsPartial" />
}
