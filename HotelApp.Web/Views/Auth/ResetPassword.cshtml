@* Bu sayfa ResetPasswordViewModel adinda bir veri kutusu bekliyor. Controller token ile birlikte gonderir. *@
@model HotelApp.Web.Models.ResetPasswordViewModel

@{
    @* Tarayici sekmesinde gorunecek baslik (Layout otomatik aliyor). *@
    ViewData["Title"] = "Şifre Yenile";
    ViewData["IsAuthPage"] = true;

    // Hero sayaçlarını ham DB sayısından kullanıcıya güven veren 10'luk ifadeye çevirir.
    int RoundStatForHero(int count) => count >= 10 ? (count / 10) * 10 : count;
}

@* AUTH SPLIT — Login/Register/ForgotPassword ile ayni kart ve gorsel dili korunur. *@
<section class="auth-split">
    <div class="auth-card">

        @* SOL: hero gorseli + serif slogan + istatistikler *@
        <aside class="auth-visual">
            <div class="auth-visual-overlay"></div>
            <div class="auth-visual-content">
                <span class="hero-eyebrow">
                    <span class="hero-dot"></span>
                    @if (Model.HeroStats is not null)
                    {
                        <text>@RoundStatForHero(Model.HeroStats.HotelCount)+ otel · @RoundStatForHero(Model.HeroStats.CityCount)+ şehir · </text>
                    }
                    güvenli şifre yenileme
                </span>
                <div class="auth-visual-bottom">
                    <h2 class="auth-visual-title">Yeni bir başlangıç.<br />Hesabını güvenle koru.</h2>
                    <div class="auth-stats">
                        @if (Model.HeroStats is not null)
                        {
                            <div class="auth-stat"><b>@RoundStatForHero(Model.HeroStats.HotelCount)+</b><span>otel</span></div>
                            <div class="auth-stat"><b>@RoundStatForHero(Model.HeroStats.CityCount)+</b><span>şehir</span></div>
                        }
                        <div class="auth-stat"><b>BCrypt</b><span>güvenli hash</span></div>
                    </div>
                </div>
            </div>
        </aside>

        @* SAG: form *@
        <div class="auth-form-col">
            <div class="auth-form-inner">

                <span class="section-eyebrow">Hesap Güvenliği</span>
                <h1 class="auth-title">Şifre Yenile</h1>
                <p class="auth-sub">Yeni şifreni belirle; işlem tamamlanınca giriş sayfasına döneceksin.</p>

                @if (Model.IsInvalidLink)
                {
                    <div class="alert alert-danger">
                        @Model.Message
                    </div>

                    <div class="text-center mt-3 auth-foot">
                        <span>Yeni bağlantı mı gerekli?</span>
                        <a asp-action="ForgotPassword">Şifre Yenileme Linki İste <i class="bi bi-arrow-right"></i></a>
                    </div>
                }
                else
                {
                    <form asp-action="ResetPassword" asp-controller="Auth" method="post" class="auth-form">
                        @* Form sahteciligine karsi guvenlik anahtari (CSRF korumasi). *@
                        @Html.AntiForgeryToken()

                        @* Backend'den gelen genel hatalar burada gorunur. *@
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* Mail linkinden gelen token kullaniciya gosterilmez; POST ile API'ye tasinir. *@
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3 auth-field">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <div class="auth-input-wrap">
                                <i class="bi bi-lock auth-input-icon"></i>
                                <input asp-for="NewPassword" autocomplete="new-password" class="form-control auth-input" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3 auth-field">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <div class="auth-input-wrap">
                                <i class="bi bi-lock-fill auth-input-icon"></i>
                                <input asp-for="ConfirmNewPassword" autocomplete="new-password" class="form-control auth-input" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-auth">Şifremi Yenile</button>

                        @* Login sayfasina geri donus linki. *@
                        <div class="text-center mt-3 auth-foot">
                            <span>Şifreni hatırladın mı?</span>
                            <a asp-action="Login">Giriş Yap <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </form>
                }

            </div>
        </div>

    </div>
</section>

@* Validation'in tarayicida da calismasi icin gerekli. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
