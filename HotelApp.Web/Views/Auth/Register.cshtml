@* Bu sayfa RegisterViewModel adinda bir veri kutusu bekliyor. Controller bos da olsa bir tane gonderir. *@
@model HotelApp.Web.Models.RegisterViewModel

@{
    @* Tarayici sekmesinde gorunecek baslik (Layout otomatik aliyor). *@
    ViewData["Title"] = "Kayıt Ol";
}

@* Form'u ortalamak icin Bootstrap grid sistemi: 5 sutunluk dar bir kutu. *@
<div class="row justify-content-center">
    <div class="col-md-6">

        <h1 class="mb-4">Kayıt Ol</h1>

        <form asp-action="Register" asp-controller="Auth" method="post">
            @* Form sahteciligine karsi guvenlik anahtari (CSRF korumasi). *@
            @Html.AntiForgeryToken()

            @* Backend'den gelen genel hatalar burada gorunur (orn: "yanlis email/sifre"). *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" autocomplete="given-name" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" autocomplete="family-name" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" autocomplete="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" autocomplete="tel" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                @* Guvenlik: Password input'larina value verilmez (DOM'da plaintext sifre gozukmesin diye). *@
                <input asp-for="Password" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>

            @* Kayit sayfasina yonlendiren alt link (UX icin guzel). *@
            <div class="text-center mt-3">
                <span>Hesabın var mı?</span>
                <a asp-action="Login">Giriş Yap</a>
            </div>
        </form>
    </div>
</div>

@* Validation'in tarayicida da (sen submit'e basmadan) calismasi icin gerekli. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // JQuery validate plugin'e telefon kuralını öğretiyoruz.
        // ASP.NET(Phone) attirubute'u client-side'da bunu kullanacak.
        // kabul edilen rakam +,- boşluk, parantez, uzunluk 7-20
        $.validator.methods.phone = function (value, element) {
            return this.optional(element) || /^[\d\s\+\-\(\)]{7,20}$/.test(value);
        };
    </script>
}