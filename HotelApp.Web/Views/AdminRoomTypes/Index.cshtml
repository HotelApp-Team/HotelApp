@model List<RoomTypeAdminViewModel>

@{
    ViewData["Title"] = "Oda Tipleri Yönetimi";
    Layout = "_AdminLayout";
}

@* TempData["Success"]/["Error"] mesajlari _AdminLayout icinde merkezi olarak gosteriliyor;
   burada tekrar render edilmesin (yoksa ayni mesaj iki kere cikar). *@
@* Kullanımda olan oda tipi silinirse API 409 Conflict döner. *@

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-door-open text-primary me-2"></i>
            Oda Tipleri Yönetimi
        </h2>
    </div>

    @* Yeni oda tipi ekleme card *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle text-primary me-2"></i>
                Yeni Oda Tipi Ekle
            </h5>
        </div>
        <div class="card-body">
            <form asp-controller="AdminRoomTypes" asp-action="Create" method="post" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Oda Tipi Adı</label>
                    <input name="Name"
                           class="form-control"
                           placeholder="Standart Oda"
                           required />
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted">Açıklama</label>
                    <input name="Description"
                           class="form-control"
                           placeholder="Oda tipi açıklaması" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Maks. Misafir</label>
                    <input name="MaxGuests"
                           type="number"
                           min="1"
                           class="form-control"
                           required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i>Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Liste kart *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Oda Tipleri
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.Count</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Henüz oda tipi bulunmuyor.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad</th>
                                <th>Açıklama</th>
                                <th>Maks. Misafir</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var roomType in Model)
                            {
                                <tr>
                                    <td colspan="4" class="p-0 border-0">
                                        @* Inline edit formu: Kaydet ile Update, Sil ile ayri form (form attribute ile bagli) *@
                                        <form asp-controller="AdminRoomTypes"
                                              asp-action="Update"
                                              method="post"
                                              class="d-grid align-items-center"
                                              style="grid-template-columns: 1fr 2fr 160px 220px; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #F1F5F9;">

                                            <input type="hidden" name="Id" value="@roomType.Id" />

                                            <input name="Name"
                                                   value="@roomType.Name"
                                                   class="form-control"
                                                   required />

                                            <input name="Description"
                                                   value="@roomType.Description"
                                                   class="form-control" />

                                            <input name="MaxGuests"
                                                   value="@roomType.MaxGuests"
                                                   type="number"
                                                   min="1"
                                                   class="form-control"
                                                   required />

                                            <div class="text-end">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-save"></i> Kaydet
                                                </button>

                                                <button type="submit"
                                                        form="delete-roomtype-@roomType.Id"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Bu oda tipini silmek istediginize emin misiniz?');">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </div>
                                        </form>

                                        <form id="delete-roomtype-@roomType.Id"
                                              asp-controller="AdminRoomTypes"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-none">
                                            <input type="hidden" name="id" value="@roomType.Id" />
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
