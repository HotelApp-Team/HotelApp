@model List<ReservationDetailViewModel>

@{
    ViewData["Title"] = "Reservasyonlarım";
}

<div class="page-header">
    <h1>Rezervasyonlarım</h1>
    <p>Konaklama detaylarını görüntüle, fatura sayfasına geç.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="app-card p-4">
        <p class="mb-0 text-muted">Henüz rezervasyonunuz bulunmuyor.</p>
    </div>
}
else
{
    <div class="app-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Otel</th>
                        <th>Oda Tipi</th>
                        <th>Giriş</th>
                        <th>Çıkış</th>
                        <th>Misafir</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td>@reservation.HotelName</td>
                            <td>@reservation.RoomTypeName</td>
                            <td>@reservation.CheckInDate.ToShortDateString()</td>
                            <td>@reservation.CheckOutDate.ToShortDateString()</td>
                            <td>@reservation.GuestCount</td>
                            <td class="fw-bold text-primary">@reservation.TotalPrice.ToString("C")</td>
                            <td>@reservation.Status</td>
                            <td>
                                <a asp-controller="Reservations"
                                   asp-action="Detail"
                                   asp-route-id="@reservation.ReservationId"
                                   class="btn btn-sm btn-outline-primary">
                                    Detay
                                </a>

                                <a asp-controller="Reservations"
                                   asp-action="Invoice"
                                   asp-route-id="@reservation.ReservationId"
                                   class="btn btn-sm btn-primary">
                                    Fatura
                                </a>

                                @if (!reservation.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                                                        && !reservation.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
                                                        && reservation.CheckInDate.Date >= DateTime.Today)
                                {
                                    <form asp-controller="Reservations"
                                          asp-action="Cancel"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@reservation.ReservationId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Rezervasyonu iptal etmek istediginize emin misiniz?');">
                                            İptal
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                        İptal edilemez
                                    </button>
                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
