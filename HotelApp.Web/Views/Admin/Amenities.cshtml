@model HotelApp.Web.Models.AdminAmenityPageViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Olanak Yönetimi";
}

@* TempData["Success"]/["Error"] mesajlari _AdminLayout icinde merkezi olarak gosteriliyor. *@

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-stars text-primary me-2"></i>
            Olanak Yönetimi
        </h2>
    </div>

    @* Yeni olanak ekleme card *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle text-primary me-2"></i>
                Yeni Olanak Ekle
            </h5>
        </div>
        <div class="card-body">
            <form asp-controller="Amenity" asp-action="Create" method="post" class="row g-3">
                <div class="col-md-5">
                    <label asp-for="CreateForm.Name" class="form-label small text-muted">Olanak Adı</label>
                    <input asp-for="CreateForm.Name" class="form-control" placeholder="Örn. Havuz" />
                    <span asp-validation-for="CreateForm.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="CreateForm.Icon" class="form-label small text-muted">İkon</label>
                    <input asp-for="CreateForm.Icon" class="form-control" placeholder="wifi, pool, parking..." />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i>Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Liste kart — RoomTypes ile ayni inline edit pattern'i *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Olanaklar
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.Amenities.Count()</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model.Amenities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad</th>
                                <th>İkon</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var amenity in Model.Amenities.OrderBy(x => x.Name))
                            {
                                <tr>
                                    <td colspan="3" class="p-0 border-0">
                                        @* Inline edit formu (Update). Sil ayri form, form attribute ile bagli. *@
                                        <form asp-controller="Amenity"
                                              asp-action="Edit"
                                              asp-route-id="@amenity.Id"
                                              method="post"
                                              class="d-grid align-items-center"
                                              style="grid-template-columns: 2fr 2fr 240px; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #F1F5F9;">

                                            <input name="Name"
                                                   value="@amenity.Name"
                                                   class="form-control"
                                                   required />

                                            <input name="Icon"
                                                   value="@amenity.Icon"
                                                   class="form-control"
                                                   placeholder="wifi, pool, parking..." />

                                            <div class="text-end">
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil-square"></i> Güncelle
                                                </button>

                                                <button type="submit"
                                                        form="delete-amenity-@amenity.Id"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Bu olanak silinsin mi?');">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </div>
                                        </form>

                                        <form id="delete-amenity-@amenity.Id"
                                              asp-controller="Amenity"
                                              asp-action="Delete"
                                              asp-route-id="@amenity.Id"
                                              method="post"
                                              class="d-none">
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Henüz olanak kaydı bulunmuyor.
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
