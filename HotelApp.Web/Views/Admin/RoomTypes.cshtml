@model List<RoomTypeAdminViewModel>


@{
    ViewData["Title"] = "Oda Tipleri Yönetimi";
    Layout = "_AdminLayout";
}

@if(TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if(TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@* Kullanımda olan oda tipi silinirse API 409 Conflict döner. *@

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Oda Tipleri Yönetimi</h2>
        <p class="page-subtitle mb-0">
            Admin panelinden oda tiplerini ekleyebilir, güncelleyebilir veya silebilirsin.
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5>Yeni Oda Tipi Ekle</h5>
    </div>

    <div class="card-body">
        <form asp-controller="RoomType" asp-action="Create" method="post" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Oda Tipi Adı</label>
                <input name="Name"
                       class="form-control"
                       placeholder="Standart Oda"
                       required />
            </div>

            <div class="col-md-5">
                <label class="form-label">Açıklama</label>
                <input name="Description"
                       class="form-control"
                       placeholder="Oda tipi açıklaması" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Maks. Misafir</label>
                <input name="MaxGuests"
                       type="number"
                       min="1"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle"></i> Ekle
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Oda Tipleri</h5>
        <span class="badge bg-secondary">@Model.Count kayıt</span>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-4 text-center text-muted">
                Henüz oda tipi bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Açıklama</th>
                            <th>Maks. Misafir</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var roomType in Model)
                        {
                            <tr>
                                <td colspan="4" class="p-0 border-0">
                                    <form asp-controller="RoomType"
                                          asp-action="Update"
                                          method="post"
                                          class="d-grid"
                                          style="grid-template-columns: 1fr 2fr 160px 220px; gap: 12px; align-items: center; padding: 12px 16px; border-bottom: 1px solid #F1F5F9;">

                                        <input type="hidden" name="Id" value="@roomType.Id" />

                                        <input name="Name"
                                               value="@roomType.Name"
                                               class="form-control"
                                               required />

                                        <input name="Description"
                                               value="@roomType.Description"
                                               class="form-control" />

                                        <input name="MaxGuests"
                                               value="@roomType.MaxGuests"
                                               type="number"
                                               min="1"
                                               class="form-control"
                                               required />

                                        <div class="text-end">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="bi bi-save"></i> Kaydet
                                            </button>

                                            <button type="submit"
                                                    form="delete-roomtype-@roomType.Id"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Bu oda tipini silmek istediginize emin misiniz?');">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </div>
                                    </form>

                                    <form id="delete-roomtype-@roomType.Id"
                                          asp-controller="RoomType"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-none">
                                        <input type="hidden" name="id" value="@roomType.Id" />
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

