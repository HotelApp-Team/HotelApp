@model HotelApp.Web.Models.AdminHotelListPageViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Otel Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Otel Yönetimi</h2>
    <a asp-controller="HotelMgmt" asp-action="Create" class="btn btn-primary">Yeni Otel Ekle</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h5 class="mb-3">Arama ve Filtreleme</h5>

<form method="get" asp-controller="HotelMgmt" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Şehir</label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Yıldız</label>
        <select asp-for="StarRating" class="form-select">
            <option value="">Tümü</option>
            @for (byte i = 1; i <= 5; i++)
            {
                <option value="@i">@i Yıldız</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Sıralama</label>
        <select asp-for="SortBy" class="form-select">
            <option value="name">Ada göre</option>
            <option value="city">Şehre göre</option>
            <option value="star">Yıldıza göre</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Sıra</label>
        <select asp-for="SortOrder" class="form-select">
            <option value="asc">Artan</option>
            <option value="desc">Azalan</option>
        </select>
    </div>

    <div class="col-md-1">
        <label class="form-label">Sayfa</label>
        <input asp-for="Page" class="form-control" />
    </div>

    <div class="col-md-1">
        <label class="form-label">Adet</label>
        <input asp-for="PageSize" class="form-control" />
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Ara</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Otel</th>
                <th>Şehir</th>
                <th>Ülke</th>
                <th>Yıldız</th>
                <th>Fiyat</th>
                <th class="text-end">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Hotels.Any())
            {
                foreach (var hotel in Model.Hotels)
                {
                    <tr>
                        <td>@hotel.Id</td>
                        <td>@hotel.Name</td>
                        <td>@hotel.City</td>
                        <td>@hotel.Country</td>
                        <td>@hotel.StarRating</td>
                        <td>
                            @if (hotel.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>@(hotel.MinPrice.HasValue? hotel.MinPrice.Value.ToString("0.00") + " ₺" : "-")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="HotelMgmt" asp-action="Edit" asp-route-id="@hotel.Id" class="btn btn-sm btn-warning">
                                    Düzenle
                                </a>

                                <form asp-controller="HotelMgmt"
                                      asp-action="Delete"
                                      asp-route-id="@hotel.Id"
                                      method="post"
                                      onsubmit="return confirm('Bu oteli silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="text-muted small">
        Toplam kayıt: @Model.TotalCount
    </div>

    @if (Model.TotalCount > Model.PageSize)
    {
        var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);

        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="HotelMgmt"
                       asp-action="Index"
                       asp-route-city="@Model.City"
                       asp-route-starRating="@Model.StarRating"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize">
                        Önceki
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">@Model.Page / @totalPages</span>
                </li>

                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="HotelMgmt"
                       asp-action="Index"
                       asp-route-city="@Model.City"
                       asp-route-starRating="@Model.StarRating"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize">
                        Sonraki
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
