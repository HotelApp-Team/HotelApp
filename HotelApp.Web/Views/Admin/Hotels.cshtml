@model HotelApp.Web.Models.AdminHotelListPageViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Otel Yönetimi";

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
    if (totalPages < 1) totalPages = 1;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-building text-primary me-2"></i>
            Otel Yönetimi
        </h2>
        <a asp-controller="HotelMgmt" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Yeni Otel Ekle
        </a>
    </div>

    @* Arama ve Filtreleme formu *@
    <form method="get" asp-controller="HotelMgmt" asp-action="Index" class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-search text-primary me-2"></i>
                Arama ve Filtreleme
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Şehir</label>
                    <input asp-for="City" class="form-control" placeholder="Şehir adı" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Yıldız</label>
                    <select asp-for="StarRating" class="form-select">
                        <option value="">Tümü</option>
                        @for (byte i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i Yıldız</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Durum</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Hepsi</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Sıralama</label>
                    <select asp-for="SortBy" class="form-select">
                        <option value="name">Ada göre</option>
                        <option value="city">Şehre göre</option>
                        <option value="star">Yıldıza göre</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Sıra</label>
                    <select asp-for="SortOrder" class="form-select">
                        <option value="asc">Artan</option>
                        <option value="desc">Azalan</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>

    @* Liste kart *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Oteller
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.TotalCount</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model.Hotels.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Otel</th>
                                <th>Şehir</th>
                                <th>Ülke</th>
                                <th>Yıldız</th>
                                <th>Durum</th>
                                <th>Min. Fiyat</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hotel in Model.Hotels)
                            {
                                <tr>
                                    <td class="text-muted small">#@hotel.Id</td>
                                    <td class="fw-semibold">@hotel.Name</td>
                                    <td>@hotel.City</td>
                                    <td>@hotel.Country</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star-fill"></i> @hotel.StarRating
                                        </span>
                                    </td>
                                    <td>
                                        @if (hotel.IsActive)
                                        {
                                            <span class="status-pill active">
                                                <span class="status-dot"></span>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill passive">
                                                <span class="status-dot"></span>
                                                Pasif
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(hotel.MinPrice.HasValue ? hotel.MinPrice.Value.ToString("N2") + " ₺" : "-")
                                    </td>
                                    <td class="text-end">
                                        <div class="action-group">
                                            <a asp-controller="HotelMgmt" asp-action="Edit" asp-route-id="@hotel.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil-square"></i> Düzenle
                                            </a>

                                            <form asp-controller="HotelMgmt"
                                                  asp-action="Delete"
                                                  asp-route-id="@hotel.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu oteli silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sayfalama *@
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                        <span class="small text-muted">
                            Sayfa @Model.Page / @totalPages
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="HotelMgmt"
                                       asp-action="Index"
                                       asp-route-city="@Model.City"
                                       asp-route-starRating="@Model.StarRating"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-sortBy="@Model.SortBy"
                                       asp-route-sortOrder="@Model.SortOrder"
                                       asp-route-page="@(Model.Page - 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        <i class="bi bi-chevron-left"></i> Önceki
                                    </a>
                                </li>
                                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="HotelMgmt"
                                       asp-action="Index"
                                       asp-route-city="@Model.City"
                                       asp-route-starRating="@Model.StarRating"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-sortBy="@Model.SortBy"
                                       asp-route-sortOrder="@Model.SortOrder"
                                       asp-route-page="@(Model.Page + 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        Sonraki <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Otel kaydı bulunamadı.
                </div>
            }

        </div>
    </div>

</div>
