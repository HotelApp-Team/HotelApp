@model HotelApp.Web.Models.AdminHotelFormViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Model.Id > 0 ? "Otel Düzenle" : "Yeni Otel";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a asp-controller="HotelMgmt" asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="post"
      asp-controller="HotelMgmt"
      asp-action="@(Model.Id > 0 ? "Edit" : "Create")"
      asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Otel Adı</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="City" class="form-label">Şehir</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Country" class="form-label">Ülke</label>
            <input asp-for="Country" class="form-control" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label">Adres</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Phone" class="form-label">Telefon</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Email" class="form-label">E-posta</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="StarRating" class="form-label">Yıldız</label>
            <input asp-for="StarRating" class="form-control" />
            <span asp-validation-for="StarRating" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Latitude" class="form-label">Latitude</label>
            <input asp-for="Latitude" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="Longitude" class="form-label">Longitude</label>
            <input asp-for="Longitude" class="form-control" />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Aktif</label>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-controller="HotelMgmt" asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@if (Model.Id == 0)
{
    <div class="alert alert-info mt-4">
        Önce otel temel bilgilerini kaydedin.
        Kaydettikten sonra olanak, görsel ve oda ekleme alanları açılacaktır.
    </div>
}

@if (Model.Id > 0)
{
    <hr class="my-5" />

    <h4>Görseller</h4>

    <form asp-controller="HotelMgmt"
          asp-action="AddImage"
          asp-route-hotelId="@Model.Id"
          method="post"
          class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label">Görsel URL</label>
            <input name="ImageUrl" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Sıra</label>
            <input name="DisplayOrder" type="number" class="form-control" value="0" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check mb-2">
                <input name="IsMain" type="checkbox" class="form-check-input" value="true" />
                <label class="form-check-label">Ana görsel</label>
            </div>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Ekle</button>
        </div>
    </form>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>URL</th>
                <th>Sıra</th>
                <th>Ana</th>
                <th class="text-end">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Images.Any())
            {
                foreach (var image in Model.Images.OrderBy(x => x.DisplayOrder))
                {
                    <tr>
                        <td colspan="4">
                            <div class="row g-2 align-items-center">

                                <div class="col-md-8">
                                    <form asp-controller="HotelMgmt"
                                          asp-action="UpdateImage"
                                          asp-route-hotelId="@Model.Id"
                                          asp-route-imageId="@image.Id"
                                          method="post"
                                          class="row g-2 align-items-center">

                                        <div class="col-md-5">
                                            <input name="ImageUrl"
                                                   value="@image.ImageUrl"
                                                   class="form-control form-control-sm" />
                                        </div>

                                        <div class="col-md-2">
                                            <input name="DisplayOrder"
                                                   value="@image.DisplayOrder"
                                                   type="number"
                                                   class="form-control form-control-sm" />
                                        </div>

                                        <div class="col-md-2">
                                            <input type="hidden" name="IsMain" value="false" />

                                            <div class="form-check">
                                                <input name="IsMain"
                                                       type="checkbox"
                                                       value="true"
                                                       class="form-check-input"
                                                       checked="@image.IsMain" />

                                                <label class="form-check-label">
                                                    Ana
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <button type="submit"
                                                    class="btn btn-sm btn-warning">
                                                Güncelle
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <div class="col-md-4 text-end">
                                    <form asp-controller="HotelMgmt"
                                          asp-action="DeleteImage"
                                          asp-route-hotelId="@Model.Id"
                                          asp-route-imageId="@image.Id"
                                          method="post"
                                          onsubmit="return confirm('Görsel silinsin mi?');">


                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Sil
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Henüz görsel eklenmemiş.</td>
                </tr>
            }
        </tbody>
    </table>

    <hr class="my-5" />

    <h4>Oda Ekle</h4>

    <form asp-controller="HotelMgmt"
          asp-action="AddRoom"
          asp-route-hotelId="@Model.Id"
          method="post"
          class="row g-3 mb-4">

        <div class="col-md-3">
            <label class="form-label">Oda Tipi</label>
            <select name="RoomTypeId" class="form-select" required>
                <option value="">Seçiniz</option>
                @foreach (var roomType in Model.RoomTypes)
                {
                    <option value="@roomType.Id">@roomType.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Gecelik Fiyat</label>
            <input name="PricePerNight" type="number" step="0.01" min="0.01" class="form-control" required />
        </div>

        <div class="col-md-3">
            <label class="form-label">Ek Misafir Fiyatı</label>
            <input name="ExtraGuestPricePerNight" type="number" step="0.01" min="0" class="form-control" required />
        </div>

        <div class="col-md-2">
            <label class="form-label">Toplam Oda</label>
            <input name="TotalRooms" type="number" min="1" class="form-control" required />
        </div>

        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Ekle</button>
        </div>
    </form>

    @if (Model.Rooms.Any())
    {
        <div class="mb-4">
            @foreach (var room in Model.Rooms)
            {
                <form asp-controller="HotelMgmt"
                      asp-action="UpdateRoom"
                      asp-route-hotelId="@Model.Id"
                      asp-route-roomId="@room.Id"
                      method="post"
                      class="row g-2 align-items-end border rounded p-3 mb-2">

                    <div class="col-md-3">
                        <label class="form-label">Oda Tipi</label>
                        <select name="RoomTypeId" class="form-select form-select-sm" required>
                            @foreach (var roomType in Model.RoomTypes)
                            {
                                if (room.RoomTypeId == roomType.Id)
                                {
                                    <option value="@roomType.Id" selected>@roomType.Name</option>
                                }
                                else
                                {
                                    <option value="@roomType.Id">@roomType.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Gecelik Fiyat</label>
                        <input name="PricePerNight"
                               value="@room.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control form-control-sm"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Ek Misafir</label>
                        <input name="ExtraGuestPricePerNight"
                               value="@room.ExtraGuestPricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control form-control-sm"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Toplam Oda</label>
                        <input name="TotalRooms"
                               value="@room.TotalRooms"
                               type="number"
                               min="1"
                               class="form-control form-control-sm"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Durum</label>
                        <select name="IsActive" class="form-select form-select-sm">
                            @if (room.IsActive)
                            {
                                <option value="true" selected>Aktif</option>
                                <option value="false">Pasif</option>
                            }
                            else
                            {
                                <option value="true">Aktif</option>
                                <option value="false" selected>Pasif</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-outline-warning w-100">
                            Kaydet
                        </button>
                    </div>
                </form>
            }
        </div>
    }
    else
    {
        <div class="text-muted mb-4">Bu otele henüz oda eklenmemiş.</div>
    }

    <hr class="my-5" />

    <h4>Oda Olanakları</h4>

    @if (Model.Rooms.Any())
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Oda Tipi</th>
                        <th>Fiyat</th>
                        <th>Olanaklar</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms.OrderBy(x => x.RoomTypeName))
                    {
                        <tr>
                            <td>
                                <strong>@room.RoomTypeName</strong>
                                <div class="text-muted small">Toplam oda: @room.TotalRooms</div>
                            </td>
                            <td>@room.PricePerNight.ToString("N0") TL</td>
                            <td>
                                <form id="room-amenities-@room.Id"
                                      asp-controller="HotelMgmt"
                                      asp-action="AssignRoomAmenities"
                                      asp-route-hotelId="@Model.Id"
                                      asp-route-roomId="@room.Id"
                                      method="post">

                                    @if (Model.AllRoomAmenities.Any())
                                    {
                                        <div class="row g-2">
                                            @foreach (var roomAmenity in Model.AllRoomAmenities.OrderBy(x => x.Name))
                                            {
                                                var isAssigned = room.RoomAmenities.Any(x => x.Id == roomAmenity.Id);

                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               name="roomAmenityIds"
                                                               value="@roomAmenity.Id"
                                                               checked="@isAssigned" />
                                                        <label class="form-check-label">@roomAmenity.Name</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Tanımlı oda olanağı bulunamadı.</span>
                                    }
                                </form>
                            </td>
                            <td class="text-end">
                                <button type="submit"
                                        form="room-amenities-@room.Id"
                                        class="btn btn-sm btn-outline-success"
                                        disabled="@(!Model.AllRoomAmenities.Any())">
                                    Güncelle
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-muted mb-4">Bu otele ait oda kaydı bulunamadı.</div>
    }

    <hr class="my-5" />

    <h4>Olanak Atama</h4>

    <form asp-controller="HotelMgmt"
          asp-action="AssignAmenities"
          asp-route-hotelId="@Model.Id"
          method="post">

        <div class="row g-2">
            @if (Model.AllAmenities.Any())
            {
                foreach (var amenity in Model.AllAmenities.OrderBy(x => x.Name))
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="amenityIds"
                                   value="@amenity.Id"
                                   checked="@amenity.IsAssigned" />
                            <label class="form-check-label">@amenity.Name</label>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-muted">Tanımlı olanak bulunamadı.</div>
            }
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-outline-success">Olanakları Güncelle</button>
        </div>
    </form>

    @if (Model.AllAmenities.Any(x => x.IsAssigned))
    {
        <div class="mt-4">
            <h5>Atanmış Olanaklar</h5>

            @foreach (var amenity in Model.AllAmenities
                .Where(x => x.IsAssigned)
                .OrderBy(x => x.Name))
            {
                <form asp-controller="HotelMgmt"
                      asp-action="RemoveAmenity"
                      asp-route-hotelId="@Model.Id"
                      asp-route-amenityId="@amenity.Id"
                      method="post"
                      class="d-inline-block me-2 mb-2"
                      onsubmit="return confirm('Bu olanak kaldırılsın mı?');">

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger">
                        @amenity.Name
                    </button>
                </form>
            }
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
