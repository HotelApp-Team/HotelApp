@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="contact-page mt-5">
    <div class="card-box">
        <h2 class="mb-3">Hakkımızda</h2>

        <p class="text-muted">
            HotelApp, Türkiye genelindeki otelleri kolayca keşfetmenizi ve birkaç tıklamayla
            rezervasyon yapmanızı sağlayan bir web uygulamasıdır. Amacımız; gezginler için
            sade, hızlı ve güvenilir bir konaklama deneyimi sunmaktır.
        </p>
        <p class="text-muted">
            Bu proje, yazılım kursumuzun final çalışması kapsamında geliştirilmektedir.
            Modern web teknolojileri ile uçtan uca bir rezervasyon platformu kurmayı hedefliyoruz.
        </p>

        <h3 class="mt-5 mb-3">Ekibimiz</h3>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-person-fill"></i>
                    <h5>Alper</h5>
                    <p>Geliştirici</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-person-fill"></i>
                    <h5>Hilal</h5>
                    <p>Geliştirici</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-person-fill"></i>
                    <h5>Sevde</h5>
                    <p>Geliştirici</p>
                </div>
            </div>
        </div>

        <h3 class="mt-5 mb-3">Kullandığımız Teknolojiler</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <i class="bi bi-server"></i>
                    <h5>Backend</h5>
                    <p>.NET 8 Web API, Entity Framework Core, SQL Server</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="contact-card">
                    <i class="bi bi-window"></i>
                    <h5>Frontend</h5>
                    <p>ASP.NET Core MVC, Razor, Bootstrap 5</p>
                </div>
            </div>
        </div>

        <p class="text-muted small mt-5 mb-0">
            HotelApp &copy; @DateTime.Now.Year — Yazılım Kursu Final Projesi
        </p>
    </div>
</div>
