@{
    ViewData["Title"] = "İletişim";
}

<div class="contact-page mt-5">
    <div class="card-box">
        <h2 class="mb-3">İletişim</h2>

        <p class="text-muted">
            HotelApp ile ilgili soru, öneri ve destek talepleriniz için bizimle iletişime geçebilirsiniz.
        </p>

        <div class="row mt-4 g-4">
            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-geo-alt-fill"></i>
                    <h5>Adres</h5>
                    <p>Ankara, Türkiye</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-telephone-fill"></i>
                    <h5>Telefon</h5>
                    <p>0850 123 45 67</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="bi bi-envelope-fill"></i>
                    <h5>E-mail</h5>
                    <p>destek@hotelapp.com</p>
                </div>
            </div>
        </div>
    </div>
</div>