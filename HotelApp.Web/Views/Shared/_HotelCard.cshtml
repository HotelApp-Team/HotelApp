@model HotelApp.Web.Models.HotelCardViewModel

<div class="hotel-card">

    <img src="@(Model.MainImageUrl ?? "/images/no-image.jpg")"
         class="hotel-img" />

    <div class="p-3">

        <h5 class="fw-bold">@Model.Name</h5>

        <p class="text-muted mb-1">
            @Model.City, @Model.Country
        </p>

        <div class="d-flex justify-content-between align-items-center">

            <span class="badge bg-primary">
                @await Html.PartialAsync("_StarRating", Model.StarRating)
            </span>

            @if (Model.AvgRating.HasValue)
            {
                <span class="badge bg-success">
                    @Model.AvgRating.Value.ToString("0.0")
                </span>
            }

        </div>

        @if (Model.MinPrice.HasValue)
        {
            <div class="mt-2">
                <span class="fw-bold text-success">
                    @Model.MinPrice.Value.ToString("0") TL
                </span>
            </div>
        }

        <a asp-controller="Hotels"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary w-100 mt-3">
            Detay
        </a>

    </div>

</div>

