<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelApp</title>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ICON (opsiyonel ama güzel durur) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- SENİN THEME -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm py-3">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building"></i> Hastur
                </a>

                <!-- MOBILE -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse" id="navbarMenu">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">
                                Anasayfa
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Hotels" asp-action="Index">
                                Oteller
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Contact">
                                İletişim
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="hero-bg"></div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="pt-5 pb-4 mt-5" style="background-color: #0f172a; color: #f8fafc; clear: both;">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h4 class="fw-bold text-primary mb-3">
                        <i class="bi bi-building"></i> Hastur
                    </h4>
                    <p class="small opacity-75">Mükemmel konaklamanızı bulun.</p>
                    <div class="d-flex gap-3">
                        <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://x.com" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-2">
                    <h6 class="fw-bold mb-3">HIZLI LİNKLER</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>
                            <a class="text-decoration-none text-light" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li>
                            <a class="text-decoration-none text-light" asp-controller="Hotels" asp-action="Index">Oteller</a>
                        </li>
                        <li>
                            <a class="text-decoration-none text-light" asp-controller="Home" asp-action="Contact">İletişim</a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="fw-bold mb-3">HESABIM</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>Giriş Yap</li>
                        <li>Kayıt Ol</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">DESTEK</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>destek@hastur.com</li>
                        <li>0850 123 45 67</li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25">
            <div class="text-center small opacity-50">
                <p>&copy; 2026 Hastur - Tüm hakları saklıdır.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

