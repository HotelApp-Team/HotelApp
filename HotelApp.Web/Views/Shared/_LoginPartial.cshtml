@using HotelApp.Web.Helpers
@{
    // Oturum helper'i token gecerliligini kontrol eder; navbar kararini buna gore verir.
    var fullName = Context.Session.GetString("UserFullName");
    var isLoggedIn = Context.Session.IsAuthenticated();
    // IsInRole token icindeki rol claim'lerine bakar; sadece admin'lere ozel link gosterimi icin.
    var isAdmin = isLoggedIn && Context.Session.IsInRole("Admin");
}
<ul class="navbar-nav">
    @if (isLoggedIn)
    {
        @* Giris yapmis kullanici icin: rezervasyon, yorum, isim + cikis butonu *@

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Reservations"
               asp-action="My">
                Rezervasyonlarim
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Reviews"
               asp-action="My">
                Yorumlarim
            </a>
        </li>

        <li class="nav-item d-flex align-items-center me-2">
            <span class="nav-link text-dark">Hosgeldin, <strong>@fullName</strong></span>
        </li>

        @if (isAdmin)
        {
            @* Admin rolu varsa navbar'da Admin Panel dropdown'i goruntulenir. *@
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-primary fw-semibold"
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-speedometer2 me-1"></i>Admin Panel
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Panel
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminUserMgmt" asp-action="Index">
                            <i class="bi bi-people-fill me-2"></i>Kullanıcılar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminLog" asp-action="Index">
                            <i class="bi bi-clock-history me-2"></i>Loglar
                        </a>
                    </li>
                </ul>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Index">Profilim</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-dark">Cikis Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Giris Yap</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Kayit Ol</a>
        </li>
    }
</ul>
