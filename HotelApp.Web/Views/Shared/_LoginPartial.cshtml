@using HotelApp.Web.Helpers
@{
    // Oturum helper'ı token geçerliliğini kontrol eder; navbar kararını buna göre verir.
    var fullName = Context.Session.GetString("UserFullName");
    var isLoggedIn = Context.Session.IsAuthenticated();
}
<ul class="navbar-nav">
    @if (isLoggedIn)
    {
        @*Giriş yapmış kullanıcı için: rezervasyon, yorum, isim + çıkış butonu*@

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Reservations"
               asp-action="My">
                Rezervasyonlarım
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Reviews"
               asp-action="My">
                Yorumlarım
            </a>
        </li>

        @* Giriş yapan kullanıcı için profil bağlantısı ve çıkış formu gösterilir. *@
        <li class="nav-item d-flex align-items-center me-2">
            <span class="nav-link text-dark"> Hoşgeldin, <strong>@fullName</strong></span>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Index">Profilim</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-dark">Çıkış Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
        </li>
    }
</ul>
