@using HotelApp.Web.Helpers
@inject IConfiguration Configuration
@{
    // Oturum helper'ı token geçerliliğini imza + issuer + audience + sure ile dogrular.
    var fullName = Context.Session.GetString("UserFullName");
    var isLoggedIn = Context.Session.IsAuthenticated(Configuration);
    // IsInRole de ayni configuration ile signature kontrolu yapan IsAuthenticated'i cagirir.
    var isAdmin = isLoggedIn && Context.Session.IsInRole(Configuration, "Admin");
}
<ul class="navbar-nav">
    @if (isLoggedIn)
    {
        @* Giris yapmis kullanici icin: tek "Hosgeldin" dropdown + (varsa) admin paneli + cikis butonu.
           Eski layoutta Rezervasyonlarim/Yorumlarim/Profilim ayri nav-item'lardi; navbar fazla
           kalabaliklaniyordu. Tek hesap menusuyle Admin Panel dropdown'i ile gorsel tutarli oldu. *@
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i>Hoşgeldin, <strong>@fullName</strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-gear me-2"></i>Profilim
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Reviews" asp-action="My">
                        <i class="bi bi-chat-left-text me-2"></i>Yorumlarım
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Reservations" asp-action="My">
                        <i class="bi bi-calendar-check me-2"></i>Rezervasyonlarım
                    </a>
                </li>
            </ul>
        </li>

        @if (isAdmin)
        {
            @* Admin rolu varsa navbar'da Admin Panel dropdown'i goruntulenir.
               _AdminLayout sidebar'i ile birebir ayni link'leri ve ikonlari kullanir,
               boylece kullanici hangi yoldan girerse girsin ayni mental model'i goruyor.
               Bootstrap 5 dropdown bundle script'i _Layout'ta yuklu, ek JS gerekmez. *@
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-primary fw-semibold"
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-speedometer2 me-1"></i>Admin Panel
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Panel
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminHotels" asp-action="Index">
                            <i class="bi bi-building me-2"></i>Oteller
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminRoomTypes" asp-action="Index">
                            <i class="bi bi-door-open me-2"></i>Oda Tipleri
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminReservations" asp-action="Index">
                            <i class="bi bi-calendar-check me-2"></i>Rezervasyonlar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminAmenities" asp-action="Index">
                            <i class="bi bi-stars me-2"></i>Olanaklar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">
                            <i class="bi bi-people-fill me-2"></i>Kullanıcılar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminReviews" asp-action="Index">
                            <i class="bi bi-chat-left-text me-2"></i>Yorumlar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="AdminLog" asp-action="Index">
                            <i class="bi bi-clock-history me-2"></i>Sistem Kayıtları
                        </a>
                    </li>
                </ul>
            </li>
        }

        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-dark">
                    <i class="bi bi-box-arrow-right me-1"></i>Çıkış Yap
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
        </li>
    }
</ul>
