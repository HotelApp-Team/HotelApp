@model HotelApp.Web.Models.ReviewViewModel

@{
    var initial = string.IsNullOrWhiteSpace(Model.UserName)
        ? "?"
        : Model.UserName.Trim().Substring(0, 1).ToUpper();
    var displayName = string.IsNullOrWhiteSpace(Model.UserName) ? "Kullanıcı" : Model.UserName;
}

<article class="testimonial-card">
    <span class="testimonial-quote">"</span>

    <div class="testimonial-stars" aria-label="@Model.Rating yıldız">
        @for (var i = 1; i <= 5; i++)
        {
            if (i <= Model.Rating)
            {
                <i class="bi bi-star-fill"></i>
            }
            else
            {
                <i class="bi bi-star"></i>
            }
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Comment))
    {
        <p class="testimonial-text">"@Model.Comment"</p>
    }

    <div class="testimonial-author">
        <div class="testimonial-avatar-fallback" aria-hidden="true">@initial</div>
        <div class="flex-grow-1">
            <div class="testimonial-name">@displayName</div>
            <div class="testimonial-date">
                <i class="bi bi-calendar3"></i>
                @Model.CreatedAt.ToString("dd MMMM yyyy")
            </div>
        </div>
    </div>
</article>
