@model byte?

<span class="star-rating">
    @for (var i = 1; i <= 5; i++)
    {
        if (Model.HasValue && i <= Model.Value)
        {
            <i class="bi bi-star-fill text-warning"></i>
        }
        else
        {
            <i class="bi bi-star text-muted"></i>
        }
    }
</span>