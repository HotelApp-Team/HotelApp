@using HotelApp.Web.Helpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // Üst menü kullanıcı bilgisini _LoginPartial ile aynı şekilde session üzerinden alır.
    var isLoggedIn = Context.Session.IsAuthenticated();
    var isAdmin = isLoggedIn && Context.Session.IsInRole("Admin");
    var userName = Context.Session.GetString("UserFullName") ?? "Yönetici";
    var userEmail = Context.Session.GetString("UserEmail") ?? "admin@hotel.com";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetici Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="bg-dark text-white p-3" style="width: 250px; min-height: 100vh;">
            <h5 class="mb-4">Yönetici Paneli</h5>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> Ana Sayfa
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminDashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Panel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        <i class="bi bi-building"></i> Oteller
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        <i class="bi bi-door-open"></i> Odalar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        <i class="bi bi-calendar-check"></i> Rezervasyonlar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminUserMgmt" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Kullanıcılar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminLog" asp-action="Index">
                        <i class="bi bi-clock-history"></i> Sistem Kayıtları
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Ust bar + icerik -->
        <div class="flex-grow-1">
            <div class="d-flex justify-content-end p-3 bg-white border-bottom">
                <div class="dropdown">
                    <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-menu-info">
                            <span class="user-menu-name">@userName Yönetici</span>
                    </span>
                    <i class="bi bi-chevron-down user-menu-caret"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                    <li class="user-dropdown-header">
                        <div>
                            <div class="fw-bold">@userName</div>
                            <div class="text-muted small">@userEmail</div>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                            Profilim
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                            </button>
                        </form>
                    </li>
                    </ul>
                </div>
            </div>
            <div class="container-fluid p-4">
                <main>
                    @* Admin islemlerinden gelen basari ve hata mesajlarini kullaniciya gosterir. *@
                    @if (TempData["Success"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
