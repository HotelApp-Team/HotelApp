<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="bg-dark text-white p-3" style="width: 250px; min-height: 100vh;">
            <h5 class="mb-4">Admin Panel</h5>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item"><a class="nav-link text-white" href="#">Oteller</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="#">Odalar</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="#">Rezervasyonlar</a></li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminUserMgmt" asp-action="Index">Kullanıcılar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AdminLog" asp-action="Index">Log Kayıtları</a>
                </li>
            </ul>
        </nav>

        <!-- Ust bar + icerik -->
        <div class="flex-grow-1">
            <nav class="navbar navbar-light bg-light border-bottom px-3">
                <span class="navbar-text">Hoşgeldiniz Admin</span>
            </nav>
            <div class="container-fluid p-4">
                <main>
                    @* Admin islemlerinden gelen basari ve hata mesajlarini kullaniciya gosterir. *@
                    @if (TempData["Success"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
