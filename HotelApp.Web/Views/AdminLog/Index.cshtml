@model HotelApp.Web.Models.AdminLogsPageViewModel
@{
    ViewData["Title"] = "Sistem Logları";
    Layout = "_AdminLayout";

    // Sayfalama hesabi: toplam kayit / sayfa basi -> toplam sayfa.
    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
    if (totalPages < 1) totalPages = 1;

    // Log filtresi geleceğe yönelik olamaz — date input'larına üst sınır.
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd");

    // Tabloda mesaj cok uzunsa kesip ".." ekle (tam metin detay modal'da gorunuyor).
    string Truncate(string? value, int maxLength)
        => string.IsNullOrEmpty(value) || value.Length <= maxLength
            ? (value ?? "")
            : value.Substring(0, maxLength) + "..";
}

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-clock-history text-primary me-2"></i>
            Sistem Logları
        </h2>
    </div>

    @* Filtre formu: GET ile gonderilir, filtreler URL query string'ine yansir *@
    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label small text-muted">Seviye</label>
                    <select name="level" class="form-select">
                        <option value="">Hepsi</option>
                        <option value="INFO" selected="@(Model.Level == "INFO")">INFO</option>
                        <option value="WARNING" selected="@(Model.Level == "WARNING")">WARNING</option>
                        <option value="ERROR" selected="@(Model.Level == "ERROR")">ERROR</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Tarihten</label>
                    <input type="date" name="dateFrom"
                           value="@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? todayIso)"
                           max="@todayIso"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Tarihe</label>
                    <input type="date" name="dateTo"
                           value="@(Model.DateTo?.ToString("yyyy-MM-dd") ?? todayIso)"
                           max="@todayIso"
                           class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Mesajda Ara</label>
                    <input type="text" name="search" value="@Model.Search"
                           class="form-control" placeholder="Mesaj içinde geçen kelime" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </form>

    @* Listeleme tablosu *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Log Kayıtları
            </h5>
            <span class="text-muted small">Toplam: <strong>@Model.TotalCount</strong></span>
        </div>
        <div class="card-body p-0">

            @if (Model.Logs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tarih</th>
                                <th>Seviye</th>
                                <th>Controller / Action</th>
                                <th>Kullanıcı</th>
                                <th>Mesaj</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                @* Seviye badge rengi: ERROR kirmizi, WARNING sari, INFO mavi *@
                                var levelClass = log.Level switch
                                {
                                    "ERROR" => "bg-danger",
                                    "WARNING" => "bg-warning text-dark",
                                    "INFO" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td>@log.Id</td>
                                    <td class="small text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge @levelClass">@log.Level</span></td>
                                    <td class="small text-nowrap">
                                        @if (!string.IsNullOrWhiteSpace(log.Controller))
                                        {
                                            <span class="text-muted">@log.Controller</span>
                                            @if (!string.IsNullOrWhiteSpace(log.Action))
                                            {
                                                <span class="text-muted">/ @log.Action</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(log.UserEmail) ? "-" : log.UserEmail)</td>
                                    <td class="small">@Truncate(log.Message, 80)</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal" data-bs-target="#logDetailModal-@log.Id">
                                            Detay
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sayfalama — filtreleri korur *@
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                        <span class="small text-muted">
                            Sayfa @Model.CurrentPage / @totalPages
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-level="@Model.Level"
                                       asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                                       asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.PageSize">Önceki</a>
                                </li>
                                <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-level="@Model.Level"
                                       asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                                       asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.PageSize">Sonraki</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Log kaydı bulunamadı.
                </div>
            }

        </div>
    </div>

</div>

@* Her log icin ayri detay modal'i: per-row pattern Users sayfasiyla ayni *@
@if (Model.Logs.Any())
{
    foreach (var log in Model.Logs)
    {
        var modalLevelClass = log.Level switch
        {
            "ERROR" => "bg-danger",
            "WARNING" => "bg-warning text-dark",
            "INFO" => "bg-info text-dark",
            _ => "bg-secondary"
        };

        <div class="modal fade" id="logDetailModal-@log.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Log Detayı #@log.Id
                            <span class="badge @modalLevelClass ms-2">@log.Level</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-muted small">Tarih</dt>
                            <dd class="col-sm-9 small">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</dd>

                            <dt class="col-sm-3 text-muted small">Controller / Action</dt>
                            <dd class="col-sm-9 small">
                                @(string.IsNullOrWhiteSpace(log.Controller) ? "-" : log.Controller)
                                @if (!string.IsNullOrWhiteSpace(log.Action))
                                {
                                    <span class="text-muted">/ @log.Action</span>
                                }
                            </dd>

                            <dt class="col-sm-3 text-muted small">Kullanıcı</dt>
                            <dd class="col-sm-9 small">
                                @if (!string.IsNullOrWhiteSpace(log.UserEmail))
                                {
                                    @log.UserEmail
                                    @if (log.UserId.HasValue)
                                    {
                                        <span class="text-muted ms-2">(Id: @log.UserId)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </dd>

                            <dt class="col-sm-3 text-muted small">IP</dt>
                            <dd class="col-sm-9 small">@(string.IsNullOrWhiteSpace(log.IpAddress) ? "-" : log.IpAddress)</dd>

                            <dt class="col-sm-3 text-muted small">Mesaj</dt>
                            <dd class="col-sm-9">@log.Message</dd>
                        </dl>

                        @* ExceptionDetail SADECE ERROR seviyesinde ve dolu ise gosterilir.
                           Trello checkItem: "ExceptionDetail sadece log detayinda ve Error seviyesinde anlamli sekilde gosterilsin" *@
                        @if (log.Level == "ERROR" && !string.IsNullOrWhiteSpace(log.ExceptionDetail))
                        {
                            <hr />
                            <div>
                                <strong class="text-danger small">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Exception Detayı
                                </strong>
                                <pre class="mt-2 p-3 bg-light border rounded small"
                                     style="max-height: 300px; overflow: auto; white-space: pre-wrap;">@log.ExceptionDetail</pre>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
