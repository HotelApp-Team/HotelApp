@model HotelApp.Web.Models.HotelDetailPageVm
@{
    ViewData["Title"] = Model.Name;

    ViewData["CheckInIso"] = Model.BookingForm.CheckInDate.ToString("yyyy-MM-dd");
    ViewData["CheckOutIso"] = Model.BookingForm.CheckOutDate.ToString("yyyy-MM-dd");
    ViewData["GuestCount"] = Model.BookingForm.GuestCount <= 0 ? 1 : Model.BookingForm.GuestCount;
}

@if (TempData["Error"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    </div>
}

<!-- ================= HERO ================= -->
<div class="hotel-hero"
    style="background-image: url('@(Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.jpg")')">
    <div class="overlay"></div>

    <div class="container hero-content">
        <h1 class="hotel-title">@Model.Name</h1>

        <p class="hotel-location">
            @Model.City, @Model.Country
        </p>

        <div class="hotel-rating">
            @await Html.PartialAsync("_StarRating", Model.StarRating)
            @if (Model.AvgRating.HasValue)
            {
                <span class="avg-rating">
                    (@Model.AvgRating.Value.ToString("0.0"))
                </span>
            }
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container mt-4">

    <div class="row">

        <!-- LEFT CONTENT -->
        <div class="col-lg-8">

            <!-- ================= ABOUT ================= -->
            <section class="card-box">
                <h3>Otel Hakkında</h3>
                <p>
                    @(Model.Description ?? "Otel açıklaması henüz eklenmemiş.")
                </p>

                <div class="info-grid">
                    <div><strong>Adres:</strong> @Model.Address</div>
                    <div><strong>Telefon:</strong> @Model.Phone</div>
                    <div><strong>E-mail:</strong> @Model.Email</div>
                </div>
            </section>

            <!-- ================= GALLERY ================= -->
            <section class="card-box mt-4">
                <h3>Galeri</h3>

                <div class="gallery-grid">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images.OrderBy(x => x.DisplayOrder))
                        {
                            <div class="gallery-item @(img.IsMain ? "main" : "")">
                                <button type="button"
                                        class="gallery-trigger border-0 bg-transparent p-0 w-100"
                                        data-bs-toggle="modal"
                                        data-bs-target="#galleryModal"
                                        data-bs-slide-to="@Model.Images.OrderBy(x => x.DisplayOrder).ToList().IndexOf(img)">
                                    <img src="@img.ImageUrl" alt="@Model.Name" class="w-100" />
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Görsel bulunamadı.</p>
                    }
                </div>
            </section>


            <!-- ================= ROOMS ================= -->
            <section id="rooms-section" class="card-box mt-4">
                <h3>Odalar</h3>

                @if (Model.Rooms != null && Model.Rooms.Any())
                {
                    if (Model.IsAuthenticated)
                    {
                        @foreach (var room in Model.Rooms)
                        {
                            @await Html.PartialAsync("_RoomCard", room)
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Rezervasyon başlatmak için giriş yapmalısınız.
                            <a asp-controller="Auth"
                               asp-action="Login"
                               asp-route-returnUrl="@Context.Request.Path">
                                Giriş Yap
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Bu otel için henüz oda bilgisi bulunmuyor.</p>
                }
            </section>

            @if (Model.Images != null && Model.Images.Any())
            {
                var orderedImages = Model.Images.OrderBy(x => x.DisplayOrder).ToList();

                <div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content bg-dark border-0">
                            <div class="modal-header border-0">
                                <h5 class="modal-title text-white" id="galleryModalLabel">@Model.Name Galerisi</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                            </div>

                            <div class="modal-body p-0">
                                <div id="galleryCarousel" class="carousel slide" data-bs-ride="false">
                                    <div class="carousel-inner">

                                        @for (int i = 0; i < orderedImages.Count; i++)
                                        {
                                            var image = orderedImages[i];

                                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                                <img src="@image.ImageUrl"
                                                     class="d-block w-100"
                                                     alt="@Model.Name"
                                                     style="max-height: 80vh; object-fit: contain; background-color: white;" />
                                            </div>
                                        }

                                    </div>

                                    @if (orderedImages.Count > 1)
                                    {
                                        <button class="carousel-control-prev"
                                                type="button"
                                                data-bs-target="#galleryCarousel"
                                                data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Önceki</span>
                                        </button>

                                        <button class="carousel-control-next"
                                                type="button"
                                                data-bs-target="#galleryCarousel"
                                                data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Sonraki</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }


            <!-- ================= REVIEWS ================= -->
            <section class="card-box mt-4">
                <h3>Yorumlar</h3>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews.OrderByDescending(x => x.CreatedAt))
                    {
                        @await Html.PartialAsync("_ReviewCard", review)
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Bu otel için henüz yorum paylaşılmamış.</p>
                }
            </section>

        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-4">

            <div class="booking-box">
                <h4>Rezervasyon</h4>

                @if (Model.IsAuthenticated)
                {
                    <p class="text-success">Giriş yapıldı. Uygun odalardan rezervasyon başlatabilirsiniz.</p>
                    <a class="btn btn-primary w-100 mt-3" href="#rooms-section">
                        Uygun Odaları Gör
                    </a>
                }
                else
                {
                    <p class="text-danger">Rezervasyon için giriş yapmalısınız.</p>
                    <a class="btn btn-outline-primary w-100 mt-3"
                       asp-controller="Auth"
                       asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path">
                        Giriş Yap ve Devam Et
                    </a>
                }
            </div>

            <!-- AMENITIES -->
            <div class="card-box mt-4">
                <h4>Olanaklar</h4>

                @if (Model.Amenities != null && Model.Amenities.Any())
                {
                    <ul class="amenity-list">
                        @foreach (var a in Model.Amenities)
                        {
                            var iconClass = "bi bi-check-circle-fill";

                            if (!string.IsNullOrWhiteSpace(a.Icon))
                            {
                                iconClass = a.Icon.StartsWith("bi ")
                                ? a.Icon
                                : $"bi bi-{a.Icon}";
                            }

                            <li>
                                <i class="@iconClass"></i>
                                <span>@a.Name</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Olanak bilgisi henüz eklenmemiş.</p>
                }
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function () {
            const galleryModal = document.getElementById('galleryModal');
            const galleryCarousel = document.getElementById('galleryCarousel');

            if (!galleryModal || !galleryCarousel) return;

            galleryModal.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                if (!trigger) return;

                const slideIndex = parseInt(trigger.getAttribute('data-bs-slide-to') || '0', 10);
                const carousel = bootstrap.Carousel.getOrCreateInstance(galleryCarousel);

                carousel.to(slideIndex);
            });
        })();
    </script>
}
