@model HotelApp.Web.Models.HotelDetailPageVm
@{
    ViewData["Title"] = Model.Name;
}


<!-- ================= HERO ================= -->
<div class="hotel-hero"
     style="background-image: url('@(Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.jpg")')">
    <div class="overlay"></div>

    <div class="container hero-content">
        <h1 class="hotel-title">@Model.Name</h1>

        <p class="hotel-location">
            @Model.City, @Model.Country
        </p>

        <div class="hotel-rating">
            @await Html.PartialAsync("_StarRating", Model.StarRating)
            @if (Model.AvgRating.HasValue)
            {
                <span class="avg-rating">
                    (@Model.AvgRating.Value.ToString("0.0"))
                </span>
            }
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container mt-4">

    <div class="row">

        <!-- LEFT CONTENT -->
        <div class="col-lg-8">

            <!-- ================= ABOUT ================= -->
            <section class="card-box">
                <h3>Otel Hakkında</h3>
                <p>
                    @(Model.Description ?? "Otel açıklaması henüz eklenmemiş.")
                </p>

                <div class="info-grid">
                    <div><strong>Adres:</strong> @Model.Address</div>
                    <div><strong>Telefon:</strong> @Model.Phone</div>
                    <div><strong>E-mail:</strong> @Model.Email</div>
                </div>
            </section>

            <!-- ================= GALLERY ================= -->
            <section class="card-box mt-4">
                <h3>Galeri</h3>

                <div class="gallery-grid">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images.OrderBy(x => x.DisplayOrder))
                        {
                            <div class="gallery-item @(img.IsMain ? "main" : "")">
                                <img src="@img.ImageUrl" alt="@Model.Name" />
                            </div>
                        }
                    }
                    else
                    {
                        <p>Görsel bulunamadı.</p>
                    }
                </div>
            </section>

            <!-- ================= ROOMS (PLACEHOLDER) Sevde Eklicek ================= -->
            <section class="card-box mt-4">
                <h3>Odalar</h3>
                @if (Model.Rooms != null && Model.Rooms.Any())
                {
                    foreach (var room in Model.Rooms)
                    {
                        @await Html.PartialAsync("_RoomCard", room)
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        Bu otel için oda bilgisi bulunamadı.
                    </div>
                }
            </section>

            <!-- ================= REVIEWS (PLACEHOLDER) Sevde Eklicek ================= -->
            <section class="card-box mt-4">
                <h3>Yorumlar</h3>
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        @await Html.PartialAsync("_ReviewCard", review)
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        Henüz yorum yapılmamış.
                    </div>
                }
            </section>

        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-4">

            <div class="booking-box">
                <h4>Rezervasyon</h4>

                @if (Model.IsAuthenticated)
                {
                    <p class="text-success">Giriş yapıldı</p>
                }
                else
                {
                    <p class="text-danger">Rezervasyon için giriş yapmalısınız</p>
                }

                <form>
                    <input type="hidden" asp-for="BookingForm.HotelId" />

                    <button class="btn btn-primary w-100 mt-3">
                        Rezervasyon Yap
                    </button>
                </form>
            </div>

            <!-- AMENITIES -->
            <div class="card-box mt-4">
                <h4>Olanaklar</h4>

                <ul class="amenity-list">
                    @foreach (var a in Model.Amenities)
                    {
                        <li>
                            @a.Name
                        </li>
                    }
                </ul>
            </div>

        </div>
    </div>
</div>