@model HotelDetailPageVm

@{
    ViewData["Title"] = Model.HotelName;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<section class="mb-4">
    <h2>@Model.HotelName</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p>@Model.Description</p>
    }

    <p class="text-muted">
        @Model.City - @Model.Address
    </p>

    @if (Model.AvgRating.HasValue)
    {
        <p>
            Puan:
            <strong>@Model.AvgRating</strong>
        </p>
    }
</section>

<hr />

<section class="mb-4">
    <h4>Odalar</h4>

    @if (Model.Rooms.Any())
    {
        foreach (var room in Model.Rooms)
        {
            @await Html.PartialAsync("_RoomCard", room)
        }
    }
    else
    {
        <div class="alert alert-info">
            Bu otel için oda bilgisi bulunamadı.
        </div>
    }
</section>

<hr />

<section class="mb-4">
    <h4>Yorum Ekle</h4>

    @if (Model.IsAuthenticated)
    {
        <form asp-controller="Reviews" asp-action="Create" method="post" class="mb-4">
            <input type="hidden" name="hotelId" value="@Model.HotelId" />
            <input type="hidden" name="HotelId" value="@Model.HotelId" />

            <div class="mb-3">
                <label class="form-label">Puan</label>
                <select name="Rating" class="form-select" required>
                    <option value="5">5 - Çok iyi</option>
                    <option value="4">4 - İyi</option>
                    <option value="3">3 - Orta</option>
                    <option value="2">2 - Kötü</option>
                    <option value="1">1 - Çok kötü</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Yorum</label>
                <textarea name="Comment" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Yorum Ekle
            </button>
        </form>
    }
    else
    {
        <div class="alert alert-warning">
            Yorum eklemek için giriş yapmalısınız.
        </div>
    }
</section>

<section class="mb-4">
    <h4>Yorumlar</h4>

    @if (Model.Reviews.Any())
    {
        foreach (var review in Model.Reviews)
        {
            @await Html.PartialAsync("_ReviewCard", review)
        }
    }
    else
    {
        <div class="alert alert-info">
            Henüz yorum yapılmamış.
        </div>
    }
</section>



