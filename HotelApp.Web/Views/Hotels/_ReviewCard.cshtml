@model ReviewViewModel

@{
    var displayName = string.IsNullOrWhiteSpace(Model.UserName) ? "Kullanıcı" : Model.UserName;
    var initial = displayName.Trim().Length > 0
        ? char.ToUpper(displayName.Trim()[0]).ToString()
        : "?";
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<article class="hd-review-card">
    <div class="hd-review-head">
        <div class="hd-review-who">
            <div class="hd-review-avatar">@initial</div>
            <div>
                <div class="hd-review-name">@displayName</div>
                <div class="hd-review-meta">
                    <span class="hd-review-stars">
                        @for (var i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <span>★</span>
                            }
                            else
                            {
                                <span class="hd-review-star-empty">★</span>
                            }
                        }
                    </span>
                    <span class="hd-review-dot"></span>
                    <span>@Model.CreatedAt.ToString("d MMMM yyyy", trCulture)</span>
                </div>
            </div>
        </div>

        @{
            // Rating 1-5 olcek; summary AvgRating ile ayni format (X,Y).
            // Renk Reviews/My ile ayni kademe: 5=excellent, 4=good, 3=ok, 1-2=bad.
            var ratingDisplay = Model.Rating.ToString("0.0", trCulture);
            var pillClass = Model.Rating == 5 ? "rating-excellent"
                : Model.Rating == 4 ? "rating-good"
                : Model.Rating == 3 ? "rating-ok"
                : "rating-bad";
        }
        <span class="rating-pill @pillClass hd-review-pill">@ratingDisplay</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Comment))
    {
        <p class="hd-review-text">@Model.Comment</p>
    }
</article>
