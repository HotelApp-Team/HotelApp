@model AvailableRoomViewModel

@{
    var roomId = Model.HotelRoomId != 0 ? Model.HotelRoomId : Model.Id;
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();

    // Search'ten gelen guestCount bu oda tipinin MaxGuests'inden buyukse
    // Booking linkinde max'a indir; aksi takdirde Booking sayfasindaki
    // <input max="@Model.MaxGuests"> validasyonu yuzunden "Değer X veya
    // daha küçük olmalıdır" hatasi cikiyordu. Min 1 ile koruyoruz.
    int requestedGuests;
    if (!int.TryParse(ViewData["GuestCount"]?.ToString(), out requestedGuests) || requestedGuests < 1)
    {
        requestedGuests = 1;
    }
    var clampedGuests = Math.Min(requestedGuests, Model.MaxGuests);
    var guestCount = clampedGuests.ToString();

    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="hd-room-wrap">
    <article class="hd-room">

        <div class="hd-room-media">
            @* Oda gorseli alani — model'de oda gorseli alani yok, bu yuzden bir
               placeholder gosteriliyor. Backend'e ileride RoomTypeImageUrl eklenirse
               buradaki <div> bir <img> ile degistirilebilir. *@
            <div class="hd-room-img-ph">
                <i class="bi bi-door-open"></i>
                <span>Oda görseli</span>
            </div>
        </div>

        <div class="hd-room-body">
            <h4 class="hd-room-name">@Model.RoomTypeName</h4>

            <div class="hd-room-sub">
                <i class="bi bi-people"></i> Maksimum @Model.MaxGuests kişi
            </div>

            <div class="hd-room-chips">
                <span class="hd-room-chip"><i class="bi bi-wifi"></i> Wi-Fi</span>
                <span class="hd-room-chip"><i class="bi bi-snow"></i> Klima</span>
                <span class="hd-room-chip"><i class="bi bi-cup-hot"></i> Kahvaltı</span>
                <span class="hd-room-chip"><i class="bi bi-tv"></i> Smart TV</span>
            </div>

            <div class="hd-room-perk">
                <i class="bi bi-check-circle-fill"></i>
                Ücretsiz iptal · Şimdi ödeme yok
            </div>
        </div>

        <div class="hd-room-price">
            <div class="hd-room-priceline">Gecelik fiyat</div>
            <div class="hd-room-price-amt">@Model.PricePerNight.ToString("N0", trCulture) TL</div>
            <div class="hd-room-pernight">vergiler dahil</div>

            <a asp-controller="Booking"
               asp-action="Create"
               asp-route-hotelId="@Model.HotelId"
               asp-route-hotelRoomId="@roomId"
               asp-route-checkIn="@checkIn"
               asp-route-checkOut="@checkOut"
               asp-route-guestCount="@guestCount"
               class="hd-room-cta">
                Rezervasyon Yap
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </article>
</div>

@* _BookingModal partial cagrisi kaldirildi: "Rezervasyon Yap" butonu artik tam sayfa
   /Booking/Create akisina yonlendiriyor, modal tetikleyici yok. Partial dosya repoda
   kalmaya devam ediyor (ileride modal akisina donulmek istenirse kullanilabilir),
   sadece her oda icin gereksiz olu DOM/JS render edilmesi engellendi. *@
