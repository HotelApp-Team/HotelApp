@model AvailableRoomViewModel

@{
    var roomId = Model.HotelRoomId != 0 ? Model.HotelRoomId : Model.Id;
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();

    // Search'ten gelen guestCount bu oda tipinin MaxGuests'inden buyukse
    // Booking linkinde max'a indir; aksi takdirde Booking sayfasindaki
    // <input max="@Model.MaxGuests"> validasyonu yuzunden "Değer X veya
    // daha küçük olmalıdır" hatasi cikiyordu. Min 1 ile koruyoruz.
    int requestedGuests;
    if (!int.TryParse(ViewData["GuestCount"]?.ToString(), out requestedGuests) || requestedGuests < 1)
    {
        requestedGuests = 1;
    }
    var clampedGuests = Math.Min(requestedGuests, Model.MaxGuests);
    var guestCount = clampedGuests.ToString();
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h5 class="card-title mb-1">@Model.RoomTypeName</h5>

                <p class="text-muted mb-2">
                    Maksimum @Model.MaxGuests kişi
                </p>

                @if (Model.AvailableRooms > 0)
                {
                    <p class="mb-1">
                        Müsait oda:
                        <strong>@Model.AvailableRooms</strong>
                    </p>
                }
                else
                {
                    <p class="mb-1">
                        Toplam oda:
                        <strong>@Model.TotalRooms</strong>
                    </p>
                }
            </div>

            <div class="text-end">
                <div class="fw-bold fs-5">
                    @Model.PricePerNight.ToString("C")
                </div>
                <small class="text-muted">gecelik</small>
            </div>
        </div>

        <a asp-controller="Booking"
           asp-action="Create"
           asp-route-hotelId="@Model.HotelId"
           asp-route-hotelRoomId="@roomId"
           asp-route-checkIn="@checkIn"
           asp-route-checkOut="@checkOut"
           asp-route-guestCount="@guestCount"
           class="btn btn-primary mt-3">
            Rezervasyon Yap
        </a>
    </div>
</div>

@* _BookingModal partial cagrisi kaldirildi: "Rezervasyon Yap" butonu artik tam sayfa
   /Booking/Create akisina yonlendiriyor, modal tetikleyici yok. Partial dosya repoda
   kalmaya devam ediyor (ileride modal akisina donulmek istenirse kullanilabilir),
   sadece her oda icin gereksiz olu DOM/JS render edilmesi engellendi. *@
