@model AvailableRoomViewModel

@{
    var roomId = Model.HotelRoomId != 0 ? Model.HotelRoomId : Model.Id;
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();

    int requestedGuests;
    if (!int.TryParse(ViewData["GuestCount"]?.ToString(), out requestedGuests) || requestedGuests < 1)
    {
        requestedGuests = 1;
    }

    var clampedGuests = Math.Min(requestedGuests, Model.MaxGuests);
    var guestCount = clampedGuests.ToString();
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="hd-room-wrap">
    <article class="hd-room">

        <div class="hd-room-media">
            <div class="hd-room-img-ph">
                <i class="bi bi-door-open"></i>
                <span>Oda görseli</span>
            </div>
        </div>

        <div class="hd-room-body">
            <h4 class="hd-room-name">@Model.RoomTypeName</h4>

            <div class="hd-room-sub">
                <i class="bi bi-people"></i> Maksimum @Model.MaxGuests kişi
            </div>

            @if (Model.RoomAmenities.Any())
            {
                <div class="hd-room-chips">
                    @foreach (var amenity in Model.RoomAmenities.OrderBy(x => x.Name))
                    {
                        var iconClass = "bi bi-check-circle";

                        if (!string.IsNullOrWhiteSpace(amenity.Icon))
                        {
                            iconClass = amenity.Icon.StartsWith("bi ")
                                ? amenity.Icon
                                : $"bi bi-{amenity.Icon}";
                        }

                        <span class="hd-room-chip"><i class="@iconClass"></i> @amenity.Name</span>
                    }
                </div>
            }

            <div class="hd-room-perk">
                <i class="bi bi-check-circle-fill"></i>
                Ücretsiz iptal · Şimdi ödeme yok
            </div>
        </div>

        <div class="hd-room-price">
            <div class="hd-room-priceline">Gecelik fiyat</div>
            <div class="hd-room-price-amt">@Model.PricePerNight.ToString("N0", trCulture) TL</div>
            <div class="hd-room-pernight">vergiler dahil</div>

            <a asp-controller="Booking"
               asp-action="Create"
               asp-route-hotelId="@Model.HotelId"
               asp-route-hotelRoomId="@roomId"
               asp-route-checkIn="@checkIn"
               asp-route-checkOut="@checkOut"
               asp-route-guestCount="@guestCount"
               class="hd-room-cta">
                Rezervasyon Yap
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </article>
</div>

@* _BookingModal / bookingModal contract note: reservation now uses full page Booking/Create flow. *@
