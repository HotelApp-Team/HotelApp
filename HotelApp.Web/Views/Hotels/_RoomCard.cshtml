@model AvailableRoomViewModel

@{
    var roomId = Model.HotelRoomId != 0 ? Model.HotelRoomId : Model.Id;
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();

    int requestedGuests;
    if (!int.TryParse(ViewData["GuestCount"]?.ToString(), out requestedGuests) || requestedGuests < 1)
    {
        requestedGuests = 1;
    }

    var clampedGuests = Math.Min(requestedGuests, Model.MaxGuests);
    var guestCount = clampedGuests.ToString();
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

@*
    data-* attribute'lari client-side siralama icin kullaniliyor (Detail.cshtml JS).
    Fiyat invariant culture ile (nokta ondalik), JS parseFloat dogru calissin.
*@
<div class="hd-room-wrap"
     data-price="@Model.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-capacity="@Model.MaxGuests"
     data-name="@Model.RoomTypeName"
     data-available="@Model.AvailableRooms">
    <article class="hd-room">

        <div class="hd-room-media">

            @{
                // Oda gorselleri: IsMain once, sonra DisplayOrder'a gore sirali.
                // MainImageUrl bos olsa bile Images dolu olabilir; ikisini de kapsa.
                var roomImages = (Model.Images ?? new List<RoomImageViewModel>())
                    .OrderByDescending(i => i.IsMain)
                    .ThenBy(i => i.DisplayOrder)
                    .ToList();
                var coverUrl = roomImages.FirstOrDefault()?.ImageUrl ?? Model.MainImageUrl;
            }

            @if (!string.IsNullOrWhiteSpace(coverUrl))
            {
                <button type="button"
                        class="hd-room-img-button"
                        data-bs-toggle="modal"
                        data-bs-target="#roomImageModal-@roomId">
                    <img src="@coverUrl"
                         alt="@Model.RoomTypeName"
                         class="hd-room-img"
                         loading="lazy" />
                    @if (roomImages.Count > 1)
                    {
                        <span class="hd-room-img-count"><i class="bi bi-images"></i> @roomImages.Count</span>
                    }
                </button>

                @* Oda gorselleri carousel modal'i (otel galerisi ile ayni yapi). *@
                <div class="modal fade hd-room-gallery-modal"
                     id="roomImageModal-@roomId"
                     tabindex="-1"
                     aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content bg-dark border-0">
                            <div class="modal-header border-0 py-2">
                                <h6 class="modal-title text-white mb-0">@Model.RoomTypeName</h6>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div id="roomCarousel-@roomId" class="carousel slide" data-bs-ride="false" data-bs-keyboard="true">
                                    <div class="carousel-inner">
                                        @if (roomImages.Any())
                                        {
                                            for (int i = 0; i < roomImages.Count; i++)
                                            {
                                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                                    <img src="@roomImages[i].ImageUrl"
                                                         class="d-block w-100"
                                                         alt="@Model.RoomTypeName"
                                                         style="max-height: 78vh; object-fit: contain; background: #fff;" />
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="carousel-item active">
                                                <img src="@coverUrl" class="d-block w-100" alt="@Model.RoomTypeName"
                                                     style="max-height: 78vh; object-fit: contain; background: #fff;" />
                                            </div>
                                        }
                                    </div>

                                    @if (roomImages.Count > 1)
                                    {
                                        <button class="carousel-control-prev" type="button"
                                                data-bs-target="#roomCarousel-@roomId" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Önceki</span>
                                        </button>
                                        <button class="carousel-control-next" type="button"
                                                data-bs-target="#roomCarousel-@roomId" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Sonraki</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="hd-room-img-ph">
                    <i class="bi bi-door-open"></i>
                    <span>Oda görseli</span>
                </div>
            }

        </div>

        <div class="hd-room-body">
            <h4 class="hd-room-name">@Model.RoomTypeName</h4>

            <div class="hd-room-sub">
                <i class="bi bi-people"></i> Maksimum @Model.MaxGuests kişi
            </div>

            @{
                // Manzara chip'i: API'den NULL gelmediyse goster.
                // Icon class prefix'i IconCssHelper ile cozulur (bi/mdi/ti destegi var).
                var hasView = !string.IsNullOrEmpty(Model.RoomViewName);
                var viewIconClass = IconCssHelper.Resolve(Model.RoomViewIcon, "bi bi-eye");
            }

            @if (hasView || Model.RoomAmenities.Any())
            {
                <div class="hd-room-chips">
                    @if (hasView)
                    {
                        <span class="hd-room-chip hd-room-view-chip"><i class="@viewIconClass"></i> @Model.RoomViewName</span>
                    }

                    @foreach (var amenity in Model.RoomAmenities.OrderBy(x => x.Name))
                    {
                        var iconClass = IconCssHelper.Resolve(amenity.Icon, "bi bi-check-circle");

                        <span class="hd-room-chip"><i class="@iconClass"></i> @amenity.Name</span>
                    }
                </div>
            }

            <div class="hd-room-perk">
                <i class="bi bi-check-circle-fill"></i>
                Ücretsiz iptal · Şimdi ödeme yok
            </div>
        </div>

        <div class="hd-room-price">
            <div class="hd-room-priceline">Gecelik fiyat</div>
            <div class="hd-room-price-amt">@Model.PricePerNight.ToString("N0", trCulture) TL</div>
            <div class="hd-room-pernight">vergiler dahil</div>

            <a asp-controller="Booking"
               asp-action="Create"
               asp-route-hotelId="@Model.HotelId"
               asp-route-hotelRoomId="@roomId"
               asp-route-checkIn="@checkIn"
               asp-route-checkOut="@checkOut"
               asp-route-guestCount="@guestCount"
               class="hd-room-cta">
                Rezervasyon Yap
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </article>
</div>

@* _BookingModal / bookingModal contract note: reservation now uses full page Booking/Create flow. *@
