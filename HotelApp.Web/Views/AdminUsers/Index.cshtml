@model HotelApp.Web.Models.AdminUsersPageViewModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_AdminLayout";

    // Pagination filtrelenmis sonuca gore hesaplanir (TotalCount global oldugu icin).
    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.FilteredCount / Model.PageSize)
        : 1;
    if (totalPages < 1) totalPages = 1;

    // Filtre uygulanmis mi? Aramada metin var ya da durum secilmisse evet.
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || Model.IsActive.HasValue;

    // Avatar icin baş harfler yardimcisi
    string GetInitials(string? firstName, string? lastName)
    {
        var first = string.IsNullOrWhiteSpace(firstName) ? "" : firstName.Trim().Substring(0, 1);
        var last = string.IsNullOrWhiteSpace(lastName) ? "" : lastName.Trim().Substring(0, 1);
        var result = (first + last).ToUpper();
        return string.IsNullOrEmpty(result) ? "?" : result;
    }

    // Rol adlarını kullanıcıya Türkçe gösterir; form value değerleri API ile uyumlu kalır.
    string GetRoleText(string? role) => role switch
    {
        "Admin" => "Yönetici",
        "User" => "Kullanıcı",
        _ => string.IsNullOrWhiteSpace(role) ? "-" : role
    };
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2>
            <i class="bi bi-people-fill"></i>
            Kullanıcı Yönetimi
        </h2>
        <p class="page-subtitle">Sistemdeki tüm kullanıcıları görüntüleyin, rolleri düzenleyin ve durumlarını yönetin.</p>
    </div>

    @* Özet istatistik kartları *@
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-value">@Model.TotalCount</div>
                <div class="stat-label">Toplam Kullanıcı</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-value">@Model.ActiveCount</div>
                <div class="stat-label">Aktif</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon rose"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="stat-value">@Model.PassiveCount</div>
                <div class="stat-label">Pasif</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-shield-check"></i></div>
            <div>
                <div class="stat-value">@Model.AdminCount</div>
                <div class="stat-label">Yönetici</div>
            </div>
        </div>
    </div>

    @* Filtre formu — name attribute'lari KORUNDU *@
    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Arama</label>
                    <div class="search-input">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" name="search" value="@Model.Search"
                               class="form-control" placeholder="Ad, soyad veya e-posta" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Durum</label>
                    <select name="isActive" class="form-select">
                        <option value="">Hepsi</option>
                        <option value="true" selected="@(Model.IsActive == true)">Aktif</option>
                        <option value="false" selected="@(Model.IsActive == false)">Pasif</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </form>

    @* Listeleme tablosu *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Kullanıcılar
            </h5>
            @* Filtre uygulanmissa kullaniciya filtrelenmis sonucu, degilse global toplami goster. *@
            @if (hasFilter)
            {
                <span class="text-muted small">Filtrelenmiş: <strong>@Model.FilteredCount</strong> / Toplam: <strong>@Model.TotalCount</strong></span>
            }
            else
            {
                <span class="text-muted small">Toplam: <strong>@Model.TotalCount</strong></span>
            }
        </div>
        <div class="card-body p-0">

            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Kullanıcı</th>
                                <th>E-posta</th>
                                <th>Telefon</th>
                                <th>Roller</th>
                                <th>Durum</th>
                                <th>Kayıt</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                var colorIndex = user.Id % 7; // 7 renk variant
                                var initials = GetInitials(user.FirstName, user.LastName);

                                <tr>
                                    <td>
                                        <div class="user-cell">
                                            <div class="avatar c@(colorIndex)">@initials</div>
                                            <div>
                                                <div class="user-name">@($"{user.FirstName} {user.LastName}".Trim())</div>
                                                <div class="user-id">#@user.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="email-cell">
                                            <i class="bi bi-envelope"></i>
                                            @user.Email
                                        </span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(user.Phone))
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                        else
                                        {
                                            @user.Phone
                                        }
                                    </td>
                                    <td>
                                        @if (user.Roles is not null && user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                var roleClass = role == "Admin" ? "bg-primary" : "bg-secondary";
                                                var roleIcon = role == "Admin" ? "bi-shield-check" : "bi-person";
                                                <span class="badge @roleClass me-1">
                                                    <i class="bi @roleIcon"></i> @GetRoleText(role)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">&mdash;</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="status-pill active">
                                                <span class="status-dot"></span>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill passive">
                                                <span class="status-dot"></span>
                                                Pasif
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <div class="action-group">
                                            @* Durum degistirme formu — backend AYNI *@
                                            <form asp-action="ChangeStatus" asp-route-id="@user.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="isActive" value="@((!user.IsActive).ToString().ToLower())" />
                                                <button type="submit"
                                                        class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                    <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                    @(user.IsActive ? "Pasifleştir" : "Aktifleştir")
                                                </button>
                                            </form>

                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal" data-bs-target="#rolesModal-@user.Id">
                                                <i class="bi bi-shield-lock"></i> Roller
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                        <span class="small text-muted">
                            Sayfa @Model.CurrentPage / @totalPages
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        <i class="bi bi-chevron-left"></i> Önceki
                                    </a>
                                </li>
                                <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-isActive="@Model.IsActive"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        Sonraki <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Kullanıcı bulunamadı.
                </div>
            }

        </div>
    </div>

</div>

@* Rol modal'lari — BACKEND AYNI, sadece kucuk gorsel rotunda *@
@if (Model.Users.Any())
{
    foreach (var user in Model.Users)
    {
        <div class="modal fade" id="rolesModal-@user.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-action="ChangeRoles" asp-route-id="@user.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-shield-lock me-2"></i>
                                Rolleri Düzenle
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small mb-3">
                                <strong>@user.Email</strong>
                            </p>

                            @{
                                var hasAdmin = user.Roles?.Contains("Admin") == true;
                                var hasUser = user.Roles?.Contains("User") == true;
                            }

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="roles" value="Admin"
                                       id="role-admin-@user.Id" checked="@hasAdmin" />
                                <label class="form-check-label" for="role-admin-@user.Id">
                                    <span class="badge bg-primary me-1"><i class="bi bi-shield-check"></i> Yönetici</span>
                                    Yönetici paneli erişimi
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="User"
                                       id="role-user-@user.Id" checked="@hasUser" />
                                <label class="form-check-label" for="role-user-@user.Id">
                                    <span class="badge bg-secondary me-1"><i class="bi bi-person"></i> Kullanıcı</span>
                                    Standart kullanıcı
                                </label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
