@model HotelApp.Web.Models.ProfilePageViewModel
@{
    ViewData["Title"] = "Profilim";

    // _AccountLayout shell konfigurasyonu — sidebar + greeting strip otomatik gelir.
    Layout = "_AccountLayout";
    ViewData["AccountTab"]          = "profile";
    ViewData["AccountPageTitle"]    = "Profilim";
    ViewData["AccountPageSubtitle"] = "Kişisel bilgilerini güncelle ve şifreni yönet.";
}

@* TempData mesajlarinin orjinal davranisi korunur (Success/Error ayri renklerde). *@
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@* E46: Profil guncelleme formu; email sadece goruntulenir, ad-soyad-telefon API'ye gonderilir. *@
@* Form ICERIGI (asp-for, label, validation) tek harfine dokunulmadi — sadece dis kart "app-card" ile sarildi. *@
<div class="app-card account-form-card mb-4">
    <div class="account-form-card-head">
        <h5 class="mb-0"><i class="bi bi-person-vcard"></i>Profil Bilgileri</h5>
    </div>
    <div class="account-form-card-body">
        <form asp-action="UpdateProfile" asp-controller="Profile" method="post">
            @Html.AntiForgeryToken()
            @{
                // PRG sonrasi TempData'dan, eski akis icin ViewData'dan oku.
                var profileError = TempData["ProfileErrorMessage"] as string ?? ViewData["ProfileErrorMessage"] as string;
            }
            @if (!string.IsNullOrWhiteSpace(profileError))
            {
                <div class="alert alert-danger" role="alert">@profileError</div>
            }

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Profile.FirstName" class="form-label"></label>
                    <input asp-for="Profile.FirstName" autocomplete="given-name" class="form-control" />
                    <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Profile.LastName" class="form-label"></label>
                    <input asp-for="Profile.LastName" autocomplete="family-name" class="form-control" />
                    <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Profile.Email" class="form-label"></label>
                @* Email guncellemesi desteklenmedigi icin bu alan submit edilmez. *@
                <input asp-for="Profile.Email" class="form-control" disabled />
                <small class="text-muted">Email adresinizi değiştiremezsiniz.</small>
            </div>

            <div class="mb-3">
                <label asp-for="Profile.Phone" class="form-label"></label>
                <input asp-for="Profile.Phone" autocomplete="tel" class="form-control" />
                <span asp-validation-for="Profile.Phone" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Bilgileri Güncelle</button>
        </form>
    </div>
</div>

@* E47: Sifre degisimi mevcut sifre, yeni sifre ve tekrar alanlariyla API'ye gonderilir.
   id="change-password" - PRG sonrasi anchor scroll icin (controller'da Url.Action(..., "change-password") kullanir). *@
<div class="app-card account-form-card mb-4" id="change-password">
    <div class="account-form-card-head">
        <h5 class="mb-0"><i class="bi bi-shield-lock"></i>Şifre Değiştir</h5>
    </div>
    <div class="account-form-card-body">
        <form asp-action="ChangePassword" asp-controller="Profile" method="post">
            @Html.AntiForgeryToken()
            @{
                // PRG sonrasi TempData'dan, eski akis icin ViewData'dan oku.
                var passwordError = TempData["PasswordErrorMessage"] as string ?? ViewData["PasswordErrorMessage"] as string;
            }
            @if (!string.IsNullOrWhiteSpace(passwordError))
            {
                <div class="alert alert-danger" role="alert">@passwordError</div>
            }

            @* Guvenlik: Sifre alanlari password input olarak kalir ve autocomplete amaci net belirtilir. *@
            <div class="mb-3">
                <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                <input asp-for="ChangePassword.CurrentPassword" autocomplete="current-password" class="form-control" />
                <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                <input asp-for="ChangePassword.NewPassword" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChangePassword.ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ChangePassword.ConfirmNewPassword" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Şifreyi Değiştir</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Profile.Phone icin kullanilan [Phone] kuralini client-side dogrulamayla uyumlu hale getirir.
        $.validator.methods.phone = function (value, element) {
            return this.optional(element) || /^[\d\s\+\-\(\)]{7,20}$/.test(value);
        };

        // PRG sonrasi URL'de #change-password gibi anchor varsa o bolume scroll et.
        // Tarayicinin native hash scroll'u POST-redirect-GET akisinda her zaman tetiklenmez,
        // bu yuzden DOM hazir oldugunda elle scrollIntoView cagiriyoruz.
        document.addEventListener('DOMContentLoaded', function () {
            if (location.hash && location.hash.length > 1) {
                var target = document.querySelector(location.hash);
                if (target) {
                    // Layout'taki sticky header altinda kalmasin diye block:'start' + ust bosluk.
                    setTimeout(function () {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 50);
                }
            }
        });
    </script>
}
