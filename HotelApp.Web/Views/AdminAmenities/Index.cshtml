<div class="modal fade" id="iconPickerModal" tabindex="-1" aria-labelledby="iconPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="iconPickerModalLabel">
                    <i class="bi bi-stars me-2"></i> İkon Seç
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="iconSearch" class="form-control mb-3" placeholder="İkon ara (örn: havuz, kahve, wi-fi, klima...)" autocomplete="off" />
                <div id="iconGrid">
                    @foreach (var icon in iconLibrary)
                    {
                        <button type="button"
                                class="icon-cell"
                                data-icon="@icon.Class"
                                data-label="@icon.Label"
                                title="@icon.Label (@icon.Class)">
                            <i class="@IconCssHelper.Resolve(icon.Class)"></i>
                            <span class="ic-label">@icon.Label</span>
                        </button>
                    }
                </div>
                <div id="iconEmpty" class="text-center text-muted py-3" style="display:none;">
                    <i class="bi bi-search me-2"></i>Aramanızla eşleşen ikon bulunamadı.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hangi form'un ikon alanina yazacagimizi takip eden state.
        // Modal acilirken trigger butonundan data-* attribute'larini alir.
        (function () {
            let activeTarget = null;   // hidden input id
            let activePreview = null;  // <i> preview id
            let activeLabel = null;    // <code> label id

            // Trigger butonlari modal acilis aninda kim oldugunu sakla.
            document.querySelectorAll('.icon-picker-trigger').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeTarget = btn.dataset.target;
                    activePreview = btn.dataset.preview;
                    activeLabel = btn.dataset.label;

                    // Modal her acildiginda arama kutusunu sifirla ve tum ikonlari goster.
                    const search = document.getElementById('iconSearch');
                    if (search) {
                        search.value = '';
                        filterIcons('');
                        setTimeout(function () { search.focus(); }, 200);
                    }
                });
            });

            // Arama input'undaki yazi degisince ikon kafesini filtrele.
            function filterIcons(query) {
                const q = (query || '').toLowerCase().trim();
                let visibleCount = 0;
                document.querySelectorAll('#iconGrid .icon-cell').forEach(function (cell) {
                    const label = (cell.dataset.label || '').toLowerCase();
                    const cls = (cell.dataset.icon || '').toLowerCase();
                    const match = !q || label.includes(q) || cls.includes(q);
                    cell.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });
                document.getElementById('iconEmpty').style.display = visibleCount === 0 ? '' : 'none';
            }

            const searchInput = document.getElementById('iconSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function (e) { filterIcons(e.target.value); });
            }

            // Icon class adina gore font family prefix'ini cikar (bi/mdi/ti destegi).
            // "bi-water"  -> "bi bi-water"
            // "mdi-pizza" -> "mdi mdi-pizza"
            // "ti-bed"    -> "ti ti-bed"
            function buildFullIconClass(iconClass) {
                if (!iconClass) return 'bi bi-grid';
                if (iconClass.startsWith('mdi-')) return 'mdi ' + iconClass;
                if (iconClass.startsWith('ti-')) return 'ti ' + iconClass;
                if (iconClass.startsWith('bi-')) return 'bi ' + iconClass;
                return 'bi bi-' + iconClass;
            }

            // Bir ikon hucresine tiklandiginda secimi aktif form'a yaz, modal'i kapat.
            document.querySelectorAll('#iconGrid .icon-cell').forEach(function (cell) {
                cell.addEventListener('click', function () {
                    if (!activeTarget) return;

                    const iconClass = cell.dataset.icon;
                    const iconLabel = cell.dataset.label;

                    // Hidden input'a sinif adini yaz (bi-water veya mdi-pizza gibi).
                    const targetInput = document.getElementById(activeTarget);
                    if (targetInput) targetInput.value = iconClass;

                    // Preview ikonu guncelle (font family prefix dahil tam class).
                    const previewEl = document.getElementById(activePreview);
                    if (previewEl) previewEl.className = buildFullIconClass(iconClass) + ' ipt-preview';

                    // Etiket (kod yazisi) guncelle.
                    const labelEl = document.getElementById(activeLabel);
                    if (labelEl) labelEl.textContent = iconClass;

                    // Modal'i kapat.
                    const modalEl = document.getElementById('iconPickerModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                });
            });
        })();
    </script>
}
