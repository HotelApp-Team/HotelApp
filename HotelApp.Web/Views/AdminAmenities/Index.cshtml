<style>
    .icon-picker-trigger {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px dashed #CBD5E1;
        background: #F8FAFC;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        text-align: left;
        transition: 120ms;
    }
    .icon-picker-trigger:hover {
        background: #EFF6FF;
        border-color: #3B82F6;
    }
    .icon-picker-trigger .ipt-preview {
        font-size: 1.5rem;
        color: #1E3A8A;
        flex-shrink: 0;
        width: 32px;
        text-align: center;
    }
    .icon-picker-trigger .ipt-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex-grow: 1;
        line-height: 1.2;
    }
    .icon-picker-trigger .ipt-info code {
        font-size: 0.78rem;
        color: #475569;
    }
    .icon-picker-trigger .ipt-info small {
        font-size: 0.72rem;
        color: #94A3B8;
    }
    .icon-picker-trigger .ipt-arrow {
        color: #94A3B8;
    }
    #iconGrid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
        gap: 8px;
        max-height: 520px;
        overflow-y: auto;
        padding: 4px;
    }
    /* Modal body scroll yapmasin, sadece icon grid scroll olsun.
       Arama input'u grid'in ustunde sabit kalir. */
    #iconPickerModal .modal-body {
        overflow: hidden;
    }
    .icon-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid #E2E8F0;
        background: white;
        border-radius: 10px;
        padding: 10px 6px;
        font-size: 1.5rem;
        cursor: pointer;
        transition: 120ms;
        color: #1E293B;
    }
    .icon-cell:hover {
        background: #EFF6FF;
        border-color: #3B82F6;
