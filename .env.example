# Docker compose icin ortam degiskenleri.
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun:
#   cp .env.example .env
# ".env" git'e COMMIT EDILMEZ (.gitignore'da). Herkes kendi makinesinde olusturur.

# SQL Server SA parolasi (guclu olmali: buyuk/kucuk harf + rakam + sembol)
SA_PASSWORD=Guclu_Parola_123!

# JWT imza anahtari (en az 32 karakter). Uretimde mutlaka degistirin.
JWT_SECRET=BuCokGizliBirAnahtarOlmaliEnAz32Karakter12345

# Mailtrap SMTP bilgileri - sadece e-posta dogrulama (Faz 2) icin gerekli.
# Faz 1'de (UseEmailVerification=false) bos birakilabilir.
MAILTRAP_USER=
MAILTRAP_PASS=
